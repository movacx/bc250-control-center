#!/usr/bin/python3 -I
"""Root-side, narrowly scoped PWM writer for BC250 Control Center."""

from __future__ import annotations

import fcntl
import hashlib
import importlib.util
import json
import math
import os
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager, suppress
from pathlib import Path

PWM_MIN = 1
PWM_MAX = 12
VALUE_MIN = 0
VALUE_MAX = 255

# NCT6687 exposes the requested manual mode before the duty register is
# necessarily ready to consume a new value.  Keep this bounded, but allow the
# register enough time to complete the automatic -> manual transition.  These
# values deliberately match the hardened Quick Access path.
PWM_MODE_VERIFY_ATTEMPTS = 10
PWM_MODE_VERIFY_INTERVAL_SECONDS = 0.05
PWM_MODE_SETTLE_SECONDS = 0.15
PWM_DUTY_VERIFY_ATTEMPTS = 16
PWM_DUTY_VERIFY_INTERVAL_SECONDS = 0.10
FAN_OPERATION_LOCK = Path('/run/bc250-control-center-fan.lock')
FAN_OPERATION_LOCK_TIMEOUT_SECONDS = 3.0

# Every duty this helper verifies is mirrored here so a root systemd unit can
# replay it at boot without pkexec ever being involved (see --restore-boot
# below).  /var/lib survives a reboot; /run does not.
STATE_DIR = Path('/var/lib/bc250-control-center')
STATE_FILE = STATE_DIR / 'fan-last-applied.json'

# System fan control (GitHub issue #15). The saved curve or preset is copied
# here by an authenticated session; a root service follows it from boot, so
# nothing at login has to ask for a password. The status and override files
# live on /run: they describe this boot only.
POLICY_FILE = STATE_DIR / 'fan-policy.json'
# The fan handed to another program (CoolerControl, fancontrol, fan2go...).
# While this file exists nothing in BC250 Control Center writes a PWM or a
# pwm_enable: no session write, no boot replay, no service, no Decky preset,
# and no "back to automatic" on the way out, which would take the channel
# from that program too. Root-owned and world-readable, like the policy.
EXTERNAL_FILE = STATE_DIR / 'fan-external.json'
EXTERNAL_REFUSAL = (
    'ERR FAN_EXTERNAL: the fan is handed to another program. '
    'Take control back on the Fans page first.'
)
RUNTIME_DIR = Path('/run/bc250-control-center')
STATUS_FILE = RUNTIME_DIR / 'fan-control.json'
OVERRIDE_FILE = RUNTIME_DIR / 'fan-override.json'
HWMON_BASE = Path('/sys/class/hwmon')
# The only chips read_temperatures() takes a reading from. Every other hwmon
# is skipped before any of its inputs are read: on a BC-250 the in-kernel
# bc250_memory driver answers a GDDR6 temperature read with eight SMU Queue 3
# messages, outside the SMN window lock the other SMU clients share, and this
# loop runs every CONTROL_INTERVAL_SECONDS from boot, next to the governor.
TEMPERATURE_CHIPS = ('amdgpu', 'k10temp', 'zenpower', 'nct')
# The BC-250's PMBus regulator driver. It stays out of TEMPERATURE_CHIPS: every
# temperature it reports is an I2C transaction with the regulator, so the loop
# reads it on its own clock (RegulatorSampler), never on the 2 s tick. It only
# registers an hwmon device when a wired regulator answers; nothing here opens
# an I2C bus itself. temp1 is "CPU VRM Temp", temp2 "GPU VRM Temp".
REGULATOR_CHIP = 'bc250_vrm'
REGULATOR_INPUTS = ('temp1_input', 'temp2_input')
REGULATOR_POLL_SECONDS = 15.0
# A sample older than this is dropped and the vrm input falls back to the
# Nuvoton "VRM MOS" channel, as if the driver were not there.
REGULATOR_STALE_SECONDS = 45.0
# Held exclusively by a CPU tuning run (bc250-cpu-smu-helper). PMBus traffic
# shares the bus with the SMU, so every regulator read holds this shared for
# the whole transaction and stands aside while a run holds it exclusively; the
# desktop reader (vrm_telemetry_reader) stands aside the same way.
SMU_RUN_LOCK = Path('/run/bc250-smu-run.lock')
CONTROL_UNIT_NAME = 'bc250-fan-control.service'
CONTROL_UNIT_PATH = Path('/etc/systemd/system') / CONTROL_UNIT_NAME
CONTROL_UNIT_WANTS = Path('/etc/systemd/system/multi-user.target.wants') / CONTROL_UNIT_NAME
CONTROL_OPENRC_NAME = 'bc250-fan-control'
LEGACY_RESTORE_UNIT = 'bc250-fan-pwm-restore.service'
OPENRC_SERVICE_HELPER = Path('/usr/libexec/bc250-control-center/bc250-openrc-service-helper')
CONTROL_MARKER = '# Managed by BC250 Control Center: system fan control'
POLICY_MAX_BYTES = 16384
CONTROL_INTERVAL_SECONDS = 2.0
CONTROL_VERIFY_SECONDS = 30.0
CONTROL_MIN_REWRITE_SECONDS = 5.0
# The fan-control engine (docs/FAN_CONTROL_V2.md): every decision about
# what duty a channel gets is made there, in code the desktop runs too. It is
# a generated, pure module (no I/O at import) shipped next to this helper.
FAN_ENGINE_NAME = 'bc250_fan_engine.py'
FAN_ENGINE_PATHS = (
    Path('/usr/libexec/bc250-control-center/lib') / FAN_ENGINE_NAME,
    Path(__file__).resolve().parent.parent / 'lib' / FAN_ENGINE_NAME,
)
REQUIRED_ENGINE_REVISION = 1
#: The schema this helper writes and reports; schema 1 is still read.
POLICY_SCHEMA = 2
_ENGINE = None


def _trusted_engine_file(path: Path) -> bool:
    """Root runs this code: root-owned, not writable by group/other, no
    symlink anywhere on the way. Same rule as bc250-system-setup-helper."""
    if os.geteuid() != 0:
        return True  # an unprivileged run (tests, --help) executes nothing as root
    for candidate in (path, *path.parents):
        try:
            info = candidate.lstat()
        except OSError:
            return False
        if stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            return False
    return True


def fan_engine():
    """The engine module, loaded once, by absolute path, after a trust check."""
    global _ENGINE
    if _ENGINE is not None:
        return _ENGINE
    for path in FAN_ENGINE_PATHS:
        if not path.is_file() or not _trusted_engine_file(path):
            continue
        sys.dont_write_bytecode = True
        spec = importlib.util.spec_from_file_location('bc250_fan_engine', path)
        if spec is None or spec.loader is None:
            continue
        module = importlib.util.module_from_spec(spec)
        sys.modules[spec.name] = module
        spec.loader.exec_module(module)
        if getattr(module, 'ENGINE_REVISION', None) != REQUIRED_ENGINE_REVISION:
            raise RuntimeError(
                f'The installed fan engine is revision {getattr(module, "ENGINE_REVISION", "?")}, '
                f'this helper needs {REQUIRED_ENGINE_REVISION}. Reinstall BC250 Control Center.'
            )
        _ENGINE = module
        return module
    raise RuntimeError('The fan engine (bc250_fan_engine.py) is missing or not trusted.')


@contextmanager
def fan_operation_lock():
    flags = os.O_CREAT | os.O_RDWR | getattr(os, 'O_CLOEXEC', 0)
    flags |= getattr(os, 'O_NOFOLLOW', 0)
    descriptor = os.open(FAN_OPERATION_LOCK, flags, 0o600)
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != 0
            or metadata.st_mode & 0o077
        ):
            raise RuntimeError('Unsafe fan operation lock.')
        deadline = time.monotonic() + FAN_OPERATION_LOCK_TIMEOUT_SECONDS
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError('Another fan operation is still in progress.')
                time.sleep(0.025)
        yield
    finally:
        os.close(descriptor)


def bc250_identity_present() -> bool:
    """Require the BC-250 identity before driving anyone's fans.

    ``find_sensor`` matches any hwmon whose name starts with ``nct``, which is
    a family of Nuvoton Super-I/O chips found on a great many ordinary
    motherboards. Every other fan path in this project checks the hardware
    first; this helper did not, and it is reachable by an administrator on any
    machine. Same check as the Game Mode helper: the BC-250's PCI id, or an
    explicit DMI board/product name.
    """
    try:
        devices = tuple(Path('/sys/bus/pci/devices').iterdir())
    except OSError:
        devices = ()
    for device in devices:
        try:
            vendor = (device / 'vendor').read_text(encoding='ascii', errors='ignore').strip().lower()
            device_id = (device / 'device').read_text(encoding='ascii', errors='ignore').strip().lower()
        except OSError:
            continue
        if vendor in {'0x1002', '1002'} and device_id in {'0x13fe', '13fe'}:
            return True
    for path in (
        Path('/sys/class/dmi/id/board_name'),
        Path('/sys/class/dmi/id/product_name'),
    ):
        try:
            if 'bc-250' in path.read_text(encoding='utf-8', errors='ignore').lower():
                return True
        except OSError:
            continue
    return False


def find_sensor() -> Path | None:
    base = Path('/sys/class/hwmon')
    for hwmon in sorted(base.glob('hwmon*')):
        try:
            name = (hwmon / 'name').read_text(encoding='utf-8').strip().lower()
        except OSError:
            continue
        if name.startswith(('nct668', 'nct67', 'nct')):
            return hwmon
    return None


def _load_state() -> dict:
    try:
        with STATE_FILE.open('r', encoding='utf-8') as stream:
            data = json.load(stream)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def _save_state(state: dict) -> None:
    """Best-effort persistence: a write failure here must never fail a fan write."""
    try:
        STATE_DIR.mkdir(mode=0o755, exist_ok=True)
        fd, name = tempfile.mkstemp(prefix='.fan-last-applied-', dir=STATE_DIR)
        temporary = Path(name)
    except OSError:
        return
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as stream:
            json.dump(state, stream)
        os.chmod(temporary, 0o644)
        os.replace(temporary, STATE_FILE)
    except OSError:
        with suppress(FileNotFoundError):
            os.unlink(temporary)


def fan_external() -> bool:
    try:
        return EXTERNAL_FILE.is_file()
    except OSError:
        return False


def _remember_applied(channel: int, value: int) -> None:
    state = _load_state()
    channels = state.get('channels')
    channels = dict(channels) if isinstance(channels, dict) else {}
    channels[str(channel)] = value
    state['channels'] = channels
    _save_state(state)


def _forget_applied(channel: int) -> None:
    state = _load_state()
    channels = state.get('channels')
    if not isinstance(channels, dict) or str(channel) not in channels:
        return
    channels = dict(channels)
    del channels[str(channel)]
    state['channels'] = channels
    _save_state(state)


def write_sysfs(path: Path, value: int) -> None:
    flags = os.O_WRONLY
    if hasattr(os, 'O_NOFOLLOW'):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags)
    try:
        os.write(fd, f'{value}\n'.encode('ascii'))
    finally:
        os.close(fd)


def wait_for_sysfs_value(
    path: Path,
    expected: str,
    *,
    retry_value: int | None = None,
    attempts: int,
    interval: float,
) -> tuple[bool, str, int, float]:
    """Wait for a hwmon register and optionally re-send its same duty.

    A first duty write can be acknowledged while the NCT controller is still
    switching out of firmware automatic control.  Retrying *only the already
    validated same value* makes the transition reliable without turning this
    helper into a general sysfs writer.
    """
    started = time.monotonic()
    observed = ''
    for attempt in range(1, max(1, attempts) + 1):
        observed = path.read_text(encoding='ascii').strip()
        if observed == expected:
            return True, observed, attempt, (time.monotonic() - started) * 1000
        if attempt < attempts:
            time.sleep(interval)
            if retry_value is not None:
                write_sysfs(path, retry_value)
    return False, observed, max(1, attempts), (time.monotonic() - started) * 1000


def restore_previous_automatic_mode(enable_path: Path | None, was_automatic: bool) -> str:
    """Best-effort rollback only when this request left firmware automatic.

    Do not force a channel that was already manual back to automatic: that
    would overwrite an existing explicit user choice.  A failed transition
    from automatic mode, however, must not leave a board fan in an unverified
    manual state.
    """
    if not was_automatic or enable_path is None:
        return ''
    try:
        write_sysfs(enable_path, 2)
        restored, observed, _attempts, _elapsed = wait_for_sysfs_value(
            enable_path,
            '2',
            attempts=PWM_MODE_VERIFY_ATTEMPTS,
            interval=PWM_MODE_VERIFY_INTERVAL_SECONDS,
        )
    except OSError as exc:
        return f' Previous automatic-mode rollback failed: {exc}.'
    if restored:
        return ' Previous automatic mode was restored.'
    return f' Previous automatic-mode rollback read-back was {observed!r}.'


def apply_pwm(channel: int, value: int, *, remember: bool = True) -> str:
    if channel < PWM_MIN or channel > PWM_MAX:
        return f'ERR PWM channel must be between {PWM_MIN} and {PWM_MAX}.'
    if value < VALUE_MIN or value > VALUE_MAX:
        return f'ERR PWM value must be between {VALUE_MIN} and {VALUE_MAX}.'

    sensor = find_sensor()
    if sensor is None:
        return 'ERR No NCT hwmon sensor was found.'

    pwm_path = sensor / f'pwm{channel}'
    enable_path = sensor / f'pwm{channel}_enable'
    if not pwm_path.is_file():
        return f'ERR {pwm_path} does not exist.'

    was_automatic = False
    try:
        if enable_path.is_file():
            was_automatic = enable_path.read_text(encoding='ascii').strip() == '2'
            write_sysfs(enable_path, 1)
            mode_ready, observed, attempts, elapsed_ms = wait_for_sysfs_value(
                enable_path,
                '1',
                attempts=PWM_MODE_VERIFY_ATTEMPTS,
                interval=PWM_MODE_VERIFY_INTERVAL_SECONDS,
            )
            if not mode_ready:
                rollback = restore_previous_automatic_mode(enable_path, was_automatic)
                return (
                    f'ERR PWM {channel} manual-mode read-back was {observed!r} after '
                    f'{attempts} attempts/{elapsed_ms:.1f} ms.{rollback}'
                )
            time.sleep(PWM_MODE_SETTLE_SECONDS)

        write_sysfs(pwm_path, value)
        duty_ready, observed, attempts, elapsed_ms = wait_for_sysfs_value(
            pwm_path,
            str(value),
            retry_value=value,
            attempts=PWM_DUTY_VERIFY_ATTEMPTS,
            interval=PWM_DUTY_VERIFY_INTERVAL_SECONDS,
        )
    except OSError as exc:
        rollback = restore_previous_automatic_mode(enable_path, was_automatic)
        return f'ERR {exc}{rollback}'
    if not duty_ready:
        rollback = restore_previous_automatic_mode(
            enable_path if enable_path.is_file() else None,
            was_automatic,
        )
        return (
            f'ERR PWM {channel} duty read-back was {observed!r} after '
            f'{attempts} attempts/{elapsed_ms:.1f} ms.{rollback}'
        )
    if remember:
        # Only a duty a person chose is replayed at boot; the service's own
        # curve outputs are recomputed from the policy instead.
        _remember_applied(channel, value)
    return f'OK PWM {channel} {value}'


def restore_automatic(channel: int) -> str:
    if channel < PWM_MIN or channel > PWM_MAX:
        return f'ERR PWM channel must be between {PWM_MIN} and {PWM_MAX}.'
    sensor = find_sensor()
    if sensor is None:
        return 'ERR No NCT hwmon sensor was found.'
    enable_path = sensor / f'pwm{channel}_enable'
    if not enable_path.is_file():
        return f'ERR {enable_path} does not exist; automatic mode cannot be restored.'
    try:
        write_sysfs(enable_path, 2)
        restored, confirmed, attempts, elapsed_ms = wait_for_sysfs_value(
            enable_path,
            '2',
            attempts=PWM_MODE_VERIFY_ATTEMPTS,
            interval=PWM_MODE_VERIFY_INTERVAL_SECONDS,
        )
    except OSError as exc:
        return f'ERR {exc}'
    if not restored:
        return (
            f'ERR PWM {channel} automatic-mode readback was {confirmed!r} after '
            f'{attempts} attempts/{elapsed_ms:.1f} ms, expected 2.'
        )
    _forget_applied(channel)
    return f'OK PWM {channel} AUTO'


# ---------------------------------------------------------------------------
# System fan control: a root service that follows the saved curve from boot
# ---------------------------------------------------------------------------
#
# GitHub issue #15. The fan curve used to be followed only by the per-user
# daemon, which reaches this helper through pkexec: the first write of every
# session could ask for a password, and after a reboot the NCT chip is back in
# firmware mode, so that write almost always happened. Here the curve is
# copied once, by an authenticated session, into a root-owned policy file, and
# a root service follows it from boot. The math deliberately mirrors
# bc250cc.domain.fan.persistence; a parity test keeps the two in step.

def validate_policy(data: object) -> dict:
    """A complete, normalized schema 2 policy, or ValueError. Schema 1 is
    migrated. Unlike the desktop normalizer this repairs nothing: the policy
    is followed as root."""
    return fan_engine().validate_policy(data)


def policy_digest(policy: dict) -> str:
    encoded = json.dumps(policy, sort_keys=True, separators=(',', ':')).encode('utf-8')
    return hashlib.sha256(encoded).hexdigest()[:16]


def _write_json_atomic(path: Path, payload: dict, *, mode: int = 0o644) -> None:
    path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=f'.{path.name}-', dir=path.parent)
    temporary = Path(name)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as stream:
            json.dump(payload, stream, sort_keys=True)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        with suppress(FileNotFoundError):
            os.unlink(temporary)


def save_policy(policy: dict) -> str:
    _write_json_atomic(POLICY_FILE, policy)
    with suppress(FileNotFoundError):
        OVERRIDE_FILE.unlink()
    return policy_digest(policy)


def load_policy() -> dict | None:
    try:
        if POLICY_FILE.stat().st_size > POLICY_MAX_BYTES:
            return None
        with POLICY_FILE.open('r', encoding='utf-8') as stream:
            return validate_policy(json.load(stream))
    except (OSError, ValueError):
        return None


def curve_percent(points: list, temperature: float) -> int:
    """The engine's interpolation (kept under its v1 name for callers)."""
    return fan_engine().interpolate(points, temperature)


def _read_temperature(path: Path) -> float | None:
    try:
        raw = int(path.read_text(encoding='ascii').strip())
    except (OSError, ValueError):
        return None
    value = raw / 1000.0
    return value if 0 < value <= 130 else None


def read_temperatures(base: Path | None = None) -> dict:
    """The same four thermal inputs the desktop daemon's curve uses.

    GPU is amdgpu ``edge``; CPU prefers k10temp/zenpower Tctl/Tdie and falls
    back to the Nuvoton channel labelled exactly ``CPU``; board and VRM come
    only from explicitly labelled NCT channels. Disconnected 0 °C inputs are
    rejected, never guessed. Chips outside ``TEMPERATURE_CHIPS`` are never
    read at all; the control loop replaces VRM with bc250_vrm when it has a
    sample (see RegulatorSampler).
    """
    base = HWMON_BASE if base is None else base
    gpu = None
    cpu: dict[int, float] = {}
    board: list[float] = []
    vrm: list[float] = []
    try:
        hwmons = sorted(base.glob('hwmon*'))
    except OSError:
        hwmons = []
    for hwmon in hwmons:
        try:
            name = (hwmon / 'name').read_text(encoding='utf-8').strip().lower()
        except OSError:
            continue
        if not any(chip in name for chip in TEMPERATURE_CHIPS):
            continue
        labels: dict[str, float] = {}
        for label_path in sorted(hwmon.glob('temp*_label')):
            try:
                label = label_path.read_text(encoding='utf-8').strip().casefold()
            except OSError:
                continue
            value = _read_temperature(hwmon / label_path.name.replace('_label', '_input'))
            if value is not None:
                labels.setdefault(label, value)
        if 'amdgpu' in name and gpu is None:
            gpu = labels.get('edge') if 'edge' in labels else _read_temperature(hwmon / 'temp1_input')
        for chip, label, rank in (
            ('k10temp', 'tctl', 0), ('k10temp', 'tdie', 1),
            ('zenpower', 'tctl', 2), ('zenpower', 'tdie', 3), ('nct', 'cpu', 4),
        ):
            if chip in name and label in labels:
                cpu.setdefault(rank, labels[label])
        if 'nct' in name:
            for label, value in labels.items():
                if label in {'system', 'board', 'motherboard'}:
                    board.append(value)
                elif 'vrm' in label:
                    vrm.append(value)
    readings = {}
    if gpu is not None:
        readings['gpu'] = gpu
    if cpu:
        readings['cpu'] = cpu[min(cpu)]
    if vrm:
        readings['vrm'] = max(vrm)
    if board:
        readings['board'] = max(board)
    return readings


def read_regulator_temperatures(base: Path | None = None) -> dict[str, float | None]:
    """Every bc250_vrm rail that answers, keyed by its input file.

    A rail mapped to None is a failed transaction (the driver answers EIO on a
    glitch); the caller keeps that rail's last good sample. An empty result
    means the driver has no device (not loaded, or no regulator wired).
    """
    base = HWMON_BASE if base is None else base
    try:
        hwmons = sorted(base.glob('hwmon*'))
    except OSError:
        return {}
    for hwmon in hwmons:
        try:
            name = (hwmon / 'name').read_text(encoding='utf-8').strip()
        except (OSError, UnicodeError):
            continue
        if name != REGULATOR_CHIP:
            continue
        return {entry: _read_temperature(hwmon / entry) for entry in REGULATOR_INPUTS}
    return {}


def _read_regulator_under_smu_lock(base: Path | None = None) -> dict[str, float | None] | None:
    """Read the rails with the SMU run lock held shared for the whole read.

    None means the read did not happen: a CPU tuning run owns the lock, or the
    lock cannot be opened. The file is created when it is missing, so a run
    can never slip in between the check and the transactions, not even on the
    first read after boot.
    """
    try:
        fd = os.open(
            SMU_RUN_LOCK,
            os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_CREAT,
            0o644,
        )
    except OSError:
        return None
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except OSError:
            return None  # a CPU tuning run owns the SMU
        return read_regulator_temperatures(base)
    finally:
        os.close(fd)


class RegulatorSampler:
    """bc250_vrm on a slow clock: one read per REGULATOR_POLL_SECONDS at most.

    Each rail keeps its own last good sample and timestamp, so one failed
    transaction only ages out that rail: the hotter rail's reading stands in
    for REGULATOR_STALE_SECONDS while the other keeps being read. Once every
    sample is older than that the caller falls back to the Nuvoton channel. A
    missing driver is just "no sample", never a failsafe.
    """

    def __init__(self) -> None:
        self.attempted_at: float | None = None
        self.samples: dict[str, tuple[float, float]] = {}

    def temperature(self, now: float) -> float | None:
        due = self.attempted_at is None or now - self.attempted_at >= REGULATOR_POLL_SECONDS
        if due:
            readings = _read_regulator_under_smu_lock()
            if readings is not None:
                self.attempted_at = now
                for entry, value in readings.items():
                    if value is not None:
                        self.samples[entry] = (value, now)
        values = [
            value for value, sampled_at in self.samples.values()
            if now - sampled_at <= REGULATOR_STALE_SECONDS
        ]
        return max(values) if values else None


def override_channels() -> set[int]:
    """Channels another BC250 control (Quick Access, a manual write) owns now."""
    try:
        with OVERRIDE_FILE.open('r', encoding='utf-8') as stream:
            data = json.load(stream)
    except (OSError, ValueError):
        return set()
    channels = data.get('channels') if isinstance(data, dict) else None
    if not isinstance(channels, list):
        return set()
    return {
        channel for channel in channels
        if isinstance(channel, int) and not isinstance(channel, bool)
        and PWM_MIN <= channel <= PWM_MAX
    }


def mark_override(channel: int, source: str) -> None:
    """Record that a user action took one channel over for the rest of this boot."""
    policy = load_policy()
    if (
        policy is None
        or channel not in fan_engine().controlled_channels(policy)
        or not control_service_enabled()
    ):
        return
    channels = sorted(override_channels() | {channel})
    with suppress(OSError):
        _write_json_atomic(
            OVERRIDE_FILE,
            {'channels': channels, 'source': source, 'at': int(time.time())},
        )


def drop_override(channel: int) -> None:
    """Hand one channel back to the policy, leaving the others' takeovers."""
    try:
        with OVERRIDE_FILE.open('r', encoding='utf-8') as stream:
            data = json.load(stream)
    except (OSError, ValueError):
        return
    if not isinstance(data, dict):
        return
    remaining = sorted(override_channels() - {channel})
    with suppress(OSError):
        if remaining:
            _write_json_atomic(OVERRIDE_FILE, {**data, 'channels': remaining})
        else:
            OVERRIDE_FILE.unlink()


def read_fan_rpm(channel: int) -> int | None:
    """The tachometer of the header this PWM drives, or None if unknown."""
    sensor = find_sensor()
    if sensor is None:
        return None
    try:
        return int((sensor / f'fan{channel}_input').read_text(encoding='ascii').strip())
    except (OSError, ValueError):
        return None


class FanController:
    """Every channel of the policy, one tick at a time, so tests can drive it
    without a thread.

    The engine proposes a duty and a new memory per channel; the memory is
    committed only once the duty is verified on the hardware, so a failed
    write never becomes the baseline the next tick smooths from, and one
    failing channel never holds back the others.
    """

    def __init__(self, *, clock=time.monotonic):
        self.clock = clock
        self.policy: dict | None = None
        self.digest = ''
        self.policy_stamp: tuple | None = None
        #: Channels this service has written (and must hand back on exit).
        self.driven: set[int] = set()
        self.regulator = RegulatorSampler()
        #: Sensors that answered at least once this boot. Losing one of them
        #: is a missing sensor, not a cooler machine.
        self.seen_sensors: set[str] = set()
        self.reset_memory()
        self.state = 'starting'
        self.error = ''
        self.snapshot: dict = {}

    @property
    def channel(self) -> int | None:
        """The primary driven channel (v1 status readers know only one)."""
        return min(self.driven) if self.driven else None

    def reset_memory(self) -> None:
        self.memories: dict = {}
        self.applied: dict[int, int] = {}
        self.last_write: dict[int, float] = {}
        self.last_verify: dict[int, float] = {}
        self.faults: dict[int, str] = {}
        self.errors: dict[int, str] = {}

    def reload_policy(self) -> None:
        try:
            info = POLICY_FILE.stat()
            stamp = (info.st_mtime_ns, info.st_size, info.st_ino)
        except OSError:
            stamp = None
        if stamp == self.policy_stamp:
            return
        self.policy_stamp = stamp
        try:
            policy = load_policy() if stamp is not None else None
            engine_error = ''
        except RuntimeError as exc:  # engine missing: never guess, leave it to firmware
            policy, engine_error = None, str(exc)
        digest = policy_digest(policy) if policy is not None else ''
        self.error = engine_error or (
            'The saved fan policy is invalid; the fan was left to firmware control.'
            if stamp is not None and policy is None else ''
        )
        if digest == self.digest:
            return
        keep = set(fan_engine().controlled_channels(policy)) if policy is not None else set()
        for channel in sorted(self.driven - keep):
            self.release_channel(channel)
        previous = self.policy
        memories, applied = dict(self.memories), dict(self.applied)
        last_write, last_verify = dict(self.last_write), dict(self.last_verify)
        latched = any(memory.source == 'critical' for memory in memories.values())
        self.policy = policy
        self.digest = digest
        self.reset_memory()
        if policy is None or previous is None:
            return
        # Editing one channel must not reset the others: a channel whose
        # setting did not change keeps its memory and its last verified duty,
        # and an emergency in force stays latched on every channel until the
        # engine sees the evidence to end it.
        for key, channel in policy['channels'].items():
            pwm = int(key)
            if previous['channels'].get(key) == channel and pwm in memories:
                self.memories[pwm] = memories[pwm]
                if pwm in applied:
                    self.applied[pwm] = applied[pwm]
                for kept, source in ((self.last_write, last_write), (self.last_verify, last_verify)):
                    if pwm in source:
                        kept[pwm] = source[pwm]
            elif latched and channel['mode'] != 'firmware':
                self.memories[pwm] = fan_engine().ChannelMemory(source='critical')

    def _read_back(self, channel: int) -> tuple[int | None, int | None]:
        sensor = find_sensor()
        if sensor is None:
            return None, None
        values = []
        for path in (sensor / f'pwm{channel}', sensor / f'pwm{channel}_enable'):
            try:
                values.append(int(path.read_text(encoding='ascii').strip()))
            except (OSError, ValueError):
                values.append(None)
        return values[0], values[1]

    def _write(self, channel: int, raw: int, now: float) -> bool:
        with fan_operation_lock():
            result = apply_pwm(channel, raw, remember=False)
        self.last_write[channel] = now
        self.last_verify[channel] = now
        if not result.startswith('OK'):
            self.errors[channel] = result[4:] if result.startswith('ERR ') else result
            return False
        self.driven.add(channel)
        self.applied[channel] = raw
        self.errors.pop(channel, None)
        return True

    def _drive(self, channel: int, decision, proposal, now: float, overrides: set[int]) -> str:
        """Apply one channel's decision. Returns that channel's state."""
        engine = fan_engine()
        if decision.action == 'release':
            if channel in self.driven:
                self.release_channel(channel)
            self.memories.pop(channel, None)
            return 'firmware'
        if decision.action == 'hold':
            self.memories[channel] = proposal  # keeps the missing-sensor clock
            return 'waiting-sensor'
        emergency = decision.source in {'critical', 'failsafe'}
        if channel in overrides:
            # Someone else wrote this register: what we applied last is no
            # longer known, so the first tick that is ours again writes.
            self.applied.pop(channel, None)
            if not emergency:
                return 'override'
            # Safety outranks whoever took the channel over: a critical
            # reading hands it back to the policy for the rest of this boot.
            drop_override(channel)
        raw = decision.raw
        if raw != self.applied.get(channel):
            last = self.last_write.get(channel)
            if (
                channel in self.errors and last is not None
                and now - last < CONTROL_MIN_REWRITE_SECONDS and not emergency
            ):
                return 'error'  # back off a failing register, except in an emergency
            if not self._write(channel, raw, now):
                self._keep_emergency(channel, decision)
                return 'error'
        elif emergency or now - self.last_verify.get(channel, 0.0) >= CONTROL_VERIFY_SECONDS:
            # In an emergency the register is read back on every tick: a
            # takeover that came and went between two ticks (Quick Access
            # lowering the duty, then resuming) leaves no override marker.
            self.last_verify[channel] = now
            value, enable = self._read_back(channel)
            if value != raw or (enable is not None and enable != 1):
                # Something outside BC250 Control Center (a driver reload, a
                # firmware reset) moved the fan. Put the policy back.
                if not self._write(channel, raw, now):
                    self._keep_emergency(channel, decision)
                    return 'error'
        channel_policy = self.policy['channels'][str(channel)]
        fault, proposal = engine.assess_stall(
            channel_policy, proposal, decision.percent, read_fan_rpm(channel), now
        )
        self.memories[channel] = proposal
        if fault:
            self.faults[channel] = fault
        else:
            self.faults.pop(channel, None)
        return 'active'

    def _keep_emergency(self, channel: int, decision) -> None:
        """A failed write keeps the old duty as the baseline, but never loses
        an emergency: the latch stays, so the next tick retries 100 %."""
        if decision.source != 'critical':
            return
        memory = self.memories.get(channel) or fan_engine().ChannelMemory()
        self.memories[channel] = fan_engine().replace_memory(memory, source='critical')

    def step(self) -> None:
        now = self.clock()
        if fan_external():
            self.driven.clear()
            self.state = 'external'
            self.snapshot = {}
            return
        self.reload_policy()
        if self.policy is None:
            for channel in sorted(self.driven):
                self.release_channel(channel)
            self.state = 'idle'
            self.snapshot = {}
            return
        if find_sensor() is None:
            self.state = 'waiting-driver'
            return
        readings = read_temperatures()
        # The regulator's own rails replace the Nuvoton "VRM MOS" channel,
        # which on a BC-250 tracks the board, not the regulator. Same choice
        # as the desktop daemon's vrm_temp.
        regulator = self.regulator.temperature(now)
        if regulator is not None:
            readings['vrm'] = regulator
        engine = fan_engine()
        self.seen_sensors |= set(engine.clean_readings(readings))
        decisions, proposals = engine.plan(
            self.policy, readings, self.memories, now, expected=self.seen_sensors
        )
        overrides = override_channels()
        for channel in sorted(self.driven - set(decisions)):
            self.release_channel(channel)  # retry a hand-back that failed earlier
        channel_states: dict[int, str] = {}
        for channel, decision in decisions.items():
            try:
                channel_states[channel] = self._drive(
                    channel, decision, proposals[channel], now, overrides
                )
            except (RuntimeError, OSError) as exc:  # one channel never stops the others
                self.errors[channel] = str(exc)
                channel_states[channel] = 'error'
        self.snapshot = self._snapshot(decisions, channel_states, readings, regulator)
        states = set(channel_states.values()) - {'firmware'}
        if not states:
            self.state = 'idle'
        elif 'active' in states:
            self.state = 'active'
        elif states == {'override'}:
            self.state = 'override'
        elif 'error' in states:
            self.state = 'error'
        else:
            self.state = 'waiting-sensor'
        if self.errors and not self.error:
            self.error = '; '.join(
                f'PWM {channel}: {message}' for channel, message in sorted(self.errors.items())
            )
        elif not self.errors and self.error.startswith('PWM '):
            self.error = ''

    def _snapshot(self, decisions, channel_states, readings, regulator) -> dict:
        channels = {}
        for channel, decision in decisions.items():
            channels[str(channel)] = {
                'state': channel_states.get(channel, ''),
                'percent': decision.percent,
                'raw': decision.raw,
                'source': decision.source,
                'sensor': decision.sensor,
                'temperature': None if decision.temperature is None else round(decision.temperature, 1),
                'fault': self.faults.get(channel, ''),
                'error': self.errors.get(channel, ''),
            }
        primary = next(
            (channel for channel, state in sorted(channel_states.items()) if state != 'firmware'),
            None,
        )
        top: dict = {}
        if primary is not None:
            decision = decisions[primary]
            source = decision.source
            top = {
                'percent': decision.percent, 'raw': decision.raw,
                # v1 readers know curve / preset / fixed / critical / failsafe.
                'source': 'preset' if source.startswith('preset:') else source,
                'temperature': None if decision.temperature is None else round(decision.temperature, 1),
                'sensor': decision.sensor,
            }
        return {
            **top,
            'readings': {name: round(value, 1) for name, value in sorted(readings.items())},
            'vrm_source': (
                REGULATOR_CHIP if regulator is not None
                else 'nct' if 'vrm' in readings else ''
            ),
            'channels': channels,
            'faults': {str(channel): fault for channel, fault in sorted(self.faults.items())},
        }

    def release_channel(self, channel: int) -> bool:
        """Hand one channel this service drove back to firmware automatic mode.

        A failed hand-back keeps the channel in ``driven`` with its error
        published, and the next tick tries again.
        """
        self.applied.pop(channel, None)
        if fan_external():
            # Handed to another program: the channel is that program's now.
            self.driven.discard(channel)
            return True
        try:
            with fan_operation_lock():
                result = restore_automatic(channel)
        except (RuntimeError, OSError) as exc:
            result = f'ERR {exc}'
        if result.startswith('OK'):
            self.driven.discard(channel)
            self.errors.pop(channel, None)
            return True
        self.errors[channel] = result[4:] if result.startswith('ERR ') else result
        return False

    def release(self) -> None:
        """Hand every channel this service drove back to firmware."""
        for channel in sorted(self.driven):
            self.release_channel(channel)

    def status(self) -> dict:
        policy = self.policy
        primary = None
        mode = ''
        if policy is not None:
            controlled = fan_engine().controlled_channels(policy)
            primary = controlled[0] if controlled else None
            if primary is not None:
                channel = policy['channels'][str(primary)]
                mode = (
                    'preset' if channel['mode'] == 'fixed' and channel.get('preset')
                    else channel['mode']
                )
        return {
            'schema': POLICY_SCHEMA,
            'policy_schemas': [1, POLICY_SCHEMA],
            'engine_revision': REQUIRED_ENGINE_REVISION,
            'pid': os.getpid(),
            'heartbeat': round(time.time(), 1),
            'state': self.state,
            'error': self.error,
            'policy_digest': self.digest,
            'mode': mode,
            'pwm': primary,
            'controlled': fan_engine().controlled_channels(policy) if policy else [],
            **self.snapshot,
        }

    def publish(self) -> None:
        with suppress(OSError):
            _write_json_atomic(STATUS_FILE, self.status())


def run_control_loop() -> int:
    if os.geteuid() != 0:
        print('ERR This helper must run as root.', flush=True)
        return 77
    if not bc250_identity_present():
        print('ERR HARDWARE_CONTEXT: AMD BC-250 hardware identity was not detected.', flush=True)
        return 19
    stop = {'requested': False}

    def request_stop(_signal, _frame) -> None:
        stop['requested'] = True

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    controller = FanController()
    print('READY system fan control', flush=True)
    try:
        while not stop['requested']:
            try:
                controller.step()
            except Exception as exc:  # keep following the fan after one bad cycle
                controller.state = 'error'
                controller.error = str(exc)
            controller.publish()
            deadline = time.monotonic() + CONTROL_INTERVAL_SECONDS
            while not stop['requested'] and time.monotonic() < deadline:
                time.sleep(0.2)
    finally:
        controller.release()
        with suppress(OSError):
            STATUS_FILE.unlink()
    return 0


def _trusted_self() -> Path:
    """The helper path a unit may point at: root-owned all the way up."""
    path = Path(__file__).resolve()
    for candidate in (path, *path.parents):
        info = candidate.stat()
        if info.st_uid != 0 or info.st_mode & 0o022:
            raise RuntimeError(f'Refusing to start an untrusted helper path: {candidate}')
    return path


def control_unit_text(helper: Path) -> str:
    # Wants= but deliberately not After= nct6687-load.service. That unit is
    # ordered after graphical.target so its settle delay never holds up the
    # login screen; a multi-user.target unit ordered after it closes an
    # ordering cycle, and systemd resolves the cycle at boot by dropping this
    # service's start job -- the one failure #15 cannot afford. The control
    # loop does not need the ordering: it reports waiting-driver and takes the
    # fan the moment the NCT hwmon appears.
    return f'''{CONTROL_MARKER}
[Unit]
Description=BC250 Control Center system fan control
Documentation=https://github.com/movacx/bc250-control-center/issues/15
After=local-fs.target systemd-udev-settle.service
Wants=nct6687-load.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart={helper} --control-loop
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=19 77
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
'''


def _init_system() -> str:
    if Path('/run/systemd/system').is_dir() and shutil.which('systemctl'):
        return 'systemd'
    if Path('/run/openrc/softlevel').exists() and shutil.which('rc-service'):
        return 'openrc'
    return ''


def control_service_enabled() -> bool:
    if CONTROL_UNIT_WANTS.is_symlink() or CONTROL_UNIT_WANTS.exists():
        return True
    return Path('/etc/runlevels/default', CONTROL_OPENRC_NAME).exists()


def _run(argv: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(argv, check=False, capture_output=True, text=True, timeout=60)


def _write_control_unit(helper: Path) -> None:
    CONTROL_UNIT_PATH.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=f'.{CONTROL_UNIT_NAME}-', dir=CONTROL_UNIT_PATH.parent)
    temporary = Path(name)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as stream:
            stream.write(control_unit_text(helper))
        os.chmod(temporary, 0o644)
        os.replace(temporary, CONTROL_UNIT_PATH)
    finally:
        with suppress(FileNotFoundError):
            os.unlink(temporary)


def refresh_control_unit() -> bool:
    """Bring an installed, managed unit up to the text this helper writes.

    An update of Control Center replaces this helper but not the unit an older
    version wrote. Saving a curve is the next authenticated moment, so the
    unit is rewritten then -- only when it is ours and it differs.
    """
    if _init_system() != 'systemd' or not CONTROL_UNIT_PATH.is_file():
        return False
    try:
        current = CONTROL_UNIT_PATH.read_text(encoding='utf-8', errors='replace')
        helper = _trusted_self()
    except (OSError, RuntimeError):
        return False
    if CONTROL_MARKER not in current or current == control_unit_text(helper):
        return False
    _write_control_unit(helper)
    _run(['systemctl', 'daemon-reload'])
    return True


def enable_control_service() -> str:
    if load_policy() is None:
        return 'ERR Save a fan curve or preset before enabling system fan control.'
    init = _init_system()
    helper = _trusted_self()
    if init == 'systemd':
        if CONTROL_UNIT_PATH.exists():
            current = CONTROL_UNIT_PATH.read_text(encoding='utf-8', errors='replace')
            if CONTROL_MARKER not in current:
                return f'ERR Refusing to replace {CONTROL_UNIT_PATH}: it is not managed by BC250 Control Center.'
        _write_control_unit(helper)
        _run(['systemctl', 'daemon-reload'])
        result = _run(['systemctl', 'enable', '--now', CONTROL_UNIT_NAME])
        if result.returncode != 0:
            return f'ERR systemctl could not start {CONTROL_UNIT_NAME}: {(result.stderr or result.stdout).strip()}'
        _run(['systemctl', 'restart', CONTROL_UNIT_NAME])
        return f'OK CONTROL ENABLED {policy_digest(load_policy())}'
    if init == 'openrc':
        if not OPENRC_SERVICE_HELPER.is_file():
            return 'ERR The protected OpenRC service helper is missing.'
        result = _run([str(OPENRC_SERVICE_HELPER), 'install', CONTROL_OPENRC_NAME])
        if result.returncode != 0:
            return f'ERR {(result.stderr or result.stdout).strip()}'
        _run(['rc-service', CONTROL_OPENRC_NAME, 'restart'])
        return f'OK CONTROL ENABLED {policy_digest(load_policy())}'
    return 'ERR System fan control needs systemd or OpenRC.'


def disable_control_service() -> str:
    init = _init_system()
    if init == 'systemd':
        if CONTROL_UNIT_PATH.exists():
            current = CONTROL_UNIT_PATH.read_text(encoding='utf-8', errors='replace')
            if CONTROL_MARKER not in current:
                return f'ERR Refusing to remove {CONTROL_UNIT_PATH}: it is not managed by BC250 Control Center.'
        _run(['systemctl', 'disable', '--now', CONTROL_UNIT_NAME])
        with suppress(FileNotFoundError):
            CONTROL_UNIT_PATH.unlink()
        _run(['systemctl', 'daemon-reload'])
    elif init == 'openrc' and OPENRC_SERVICE_HELPER.is_file():
        result = _run([str(OPENRC_SERVICE_HELPER), 'remove', CONTROL_OPENRC_NAME])
        if result.returncode != 0:
            return f'ERR {(result.stderr or result.stdout).strip()}'
    for path in (POLICY_FILE, OVERRIDE_FILE):
        with suppress(FileNotFoundError):
            path.unlink()
    return 'OK CONTROL DISABLED'


def external_command(on: bool) -> str:
    """Hand the fan to another program, or take it back.

    Handing it over writes nothing to the fan: the system service is
    removed (its exit leaves the channel alone, see release()), the policy,
    the Decky takeover and the duty replayed at boot are forgotten, so the
    other program finds the fan exactly as it left it. Taking it back only
    removes the marker: the fan stays as that program left it until the user
    applies something on the Fans page.
    """
    if not on:
        with suppress(FileNotFoundError):
            EXTERNAL_FILE.unlink()
        return 'OK EXTERNAL OFF'
    _write_json_atomic(EXTERNAL_FILE, {'schema': 1, 'since': int(time.time())})
    if control_service_enabled() or CONTROL_UNIT_PATH.exists():
        result = disable_control_service()
        if not result.startswith('OK'):
            return result
    for path in (POLICY_FILE, OVERRIDE_FILE):
        with suppress(FileNotFoundError):
            path.unlink()
    state = _load_state()
    if state.get('channels'):
        state['channels'] = {}
        _save_state(state)
    return 'OK EXTERNAL ON'


def session_policy_command(line: str) -> str:
    if line == 'POLICY-CLEAR':
        with suppress(FileNotFoundError):
            POLICY_FILE.unlink()
        with suppress(FileNotFoundError):
            OVERRIDE_FILE.unlink()
        return 'OK POLICY CLEARED'
    payload = line[len('POLICY '):]
    if len(payload.encode('utf-8')) > POLICY_MAX_BYTES:
        return 'ERR The fan policy is too large.'
    try:
        policy = validate_policy(json.loads(payload))
    except ValueError as exc:
        return f'ERR {exc}'
    digest = save_policy(policy)
    refresh_control_unit()
    return f'OK POLICY {digest}'


def session() -> int:
    # Every other helper in this directory refuses before it does anything.
    # This one announced READY and opened its command session to any local
    # user, then failed on each individual write instead. Failing closed here
    # keeps the privileged surface uniform and the failure legible.
    if os.geteuid() != 0:
        print('ERR This helper must run as root through pkexec.', flush=True)
        return 77
    if not bc250_identity_present():
        print(
            'ERR HARDWARE_CONTEXT: AMD BC-250 hardware identity was not detected.',
            flush=True,
        )
        return 19
    print('READY', flush=True)
    for raw_line in sys.stdin:
        line = raw_line.strip()
        if not line:
            continue
        if line == 'EXIT':
            print('BYE', flush=True)
            return 0
        try:
            if line in {'EXTERNAL ON', 'EXTERNAL OFF'}:
                print(external_command(line == 'EXTERNAL ON'), flush=True)
                continue
            if fan_external() and line not in {'POLICY-CLEAR', 'CONTROL DISABLE'}:
                print(EXTERNAL_REFUSAL, flush=True)
                continue
            if line == 'POLICY-CLEAR' or line.startswith('POLICY '):
                print(session_policy_command(line), flush=True)
                continue
            if line == 'CONTROL ENABLE':
                print(enable_control_service(), flush=True)
                continue
            if line == 'CONTROL DISABLE':
                print(disable_control_service(), flush=True)
                continue
            parts = line.split()
            if len(parts) == 2 and parts[0] == 'AUTO':
                with fan_operation_lock():
                    result = restore_automatic(int(parts[1]))
                if result.startswith('OK'):
                    mark_override(int(parts[1]), 'session')
                print(result, flush=True)
                continue
            if len(parts) != 2:
                raise ValueError('Expected PWM channel and value, or AUTO and channel.')
            with fan_operation_lock():
                result = apply_pwm(int(parts[0]), int(parts[1]))
            if result.startswith('OK'):
                # While the system service follows a policy, a direct write
                # from the desktop is a deliberate takeover of that channel;
                # the next POLICY hands it back.
                mark_override(int(parts[0]), 'session')
            print(result, flush=True)
        except (RuntimeError, ValueError, OSError) as exc:
            print(f'ERR {exc}', flush=True)
    return 0


def restore_boot_state() -> int:
    """Reapply the last verified PWM duty directly, with no pkexec involved.

    A systemd unit runs this as root at boot, the same way nct6687-load.service
    already brings the module back without any prompt.  It only ever replays a
    (channel, value) pair this same helper already wrote and verified once
    through the normal, authenticated session() path.
    """
    if os.geteuid() != 0:
        print('ERR This helper must run as root.', flush=True)
        return 77
    if not bc250_identity_present():
        print(
            'ERR HARDWARE_CONTEXT: AMD BC-250 hardware identity was not detected.',
            flush=True,
        )
        return 19
    if fan_external():
        print('OK the fan is handed to another program', flush=True)
        return 0
    owned: set[int] = set()
    if control_service_enabled():
        try:
            policy = load_policy()
        except RuntimeError as exc:
            print(f'ERR {exc}', flush=True)
            return 1
        if policy is None and POLICY_FILE.exists():
            # An invalid policy means "firmware", never "the last duties".
            print('OK the saved fan policy is invalid; the fan stays with the firmware', flush=True)
            return 0
        if policy is not None:
            # The system service follows the policy from boot; replaying an
            # older one-off duty on those channels would only race it.
            owned = set(fan_engine().controlled_channels(policy))
    channels = _load_state().get('channels')
    if not isinstance(channels, dict) or not channels:
        print('OK nothing to restore', flush=True)
        return 0
    channels = {
        key: value for key, value in channels.items()
        if not (isinstance(key, str) and key.isdigit() and int(key) in owned)
    }
    if not channels:
        print('OK system fan control owns the boot state', flush=True)
        return 0
    failures = 0
    for channel_text, value in channels.items():
        try:
            channel = int(channel_text)
            value = int(value)
        except (TypeError, ValueError):
            failures += 1
            print(f'ERR invalid saved PWM entry {channel_text!r}={value!r}', flush=True)
            continue
        with fan_operation_lock():
            result = apply_pwm(channel, value)
        print(result, flush=True)
        if not result.startswith('OK'):
            failures += 1
    return 1 if failures else 0


if __name__ == '__main__':
    if len(sys.argv) > 1 and sys.argv[1] == '--restore-boot':
        raise SystemExit(restore_boot_state())
    if len(sys.argv) > 1 and sys.argv[1] == '--control-loop':
        raise SystemExit(run_control_loop())
    raise SystemExit(session())
