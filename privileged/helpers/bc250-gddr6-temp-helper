def bios_version() -> str:
    try:
        return pathlib.Path("/sys/class/dmi/id/bios_version").read_text(
            encoding="utf-8", errors="ignore"
        ).strip()
    except OSError:
        return ""


def _open_smn_window(path: str) -> tuple[int, bool]:
    """Open the window writable when allowed, so its index can be restored."""
    try:
        return os.open(path, os.O_RDWR | os.O_CLOEXEC), True
    except PermissionError:
        return os.open(path, os.O_RDONLY | os.O_CLOEXEC), False


def _read_smn_index(fd: int) -> int | None:
    try:
        data = os.pread(fd, 4, SMN_INDEX_OFFSET)
    except OSError:
        return None
    return struct.unpack("<I", data)[0] if len(data) == 4 else None


def _restore_smn_index(fd: int, saved: int | None) -> None:
    """Put back the register another client selected before this one ran.

    Only once the index is proven to read back what is written: restoring a
    value the hardware never really reported would misdirect a pending
    access just as badly as not restoring at all.
    """
    if saved is None:
        return
    try:
        os.pwrite(fd, struct.pack("<I", SMN_INDEX_PROBE), SMN_INDEX_OFFSET)
        if _read_smn_index(fd) != SMN_INDEX_PROBE:
            return
        os.pwrite(fd, struct.pack("<I", saved), SMN_INDEX_OFFSET)
    except OSError:
        return


@contextlib.contextmanager
def smu_run_share(path: str | None = None):
    """Stand aside while the CPU tuning helper is using the SMU.

    A CPU detection or apply sends several multi-step messages on Queue 3, and
    its payload locks each 32-bit access rather than each message. A sample
    taken between two steps of one of those messages clears the response
    register or overwrites its argument, and the tuning reads
    ``smu returned status 0x00``. The helper therefore holds ``path``
    exclusively for the whole run; each sample here takes it shared and gives
    up at once when it is held, instead of waiting inside the run.
    """
    try:
        fd = os.open(
            path or SMU_RUN_LOCK_PATH,
            os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o644,
        )
    except OSError:
        # Cannot coordinate (for example a read-only /run): behave as before.
        yield
        return
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except OSError:
            raise RuntimeError(
                "SMU_BUSY: CPU overclocking is using the SMU right now. Wait for "
                "it to finish and try again."
            ) from None
        try:
            yield
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


@contextlib.contextmanager
def smn_window_lock(
    timeout: float = SMN_LOCK_TIMEOUT_SECONDS, path: str = SMN_WINDOW_PATH
):
    """Hold the advisory lock the other SMU clients on this board honour.

    Non-blocking with a deadline rather than a blocking ``flock``: the CPU OC
    tool can hold this for the length of a detection run, and a helper that
    waits forever would leave a Polkit-launched process hanging with no way
    for the desktop to explain why.
    """
    with smu_run_share():
        fd, writable = _open_smn_window(path)
        deadline = time.monotonic() + max(0.0, float(timeout))
        try:
            while True:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except OSError:
                    if time.monotonic() >= deadline:
                        raise RuntimeError(
                            "SMU_BUSY: another BC-250 tool is holding the SMU interface "
                            "(CPU overclocking or the GPU governor). Wait for it to "
                            "finish and try again."
                        ) from None
                    time.sleep(0.05)
            saved = _read_smn_index(fd) if writable else None
            try:
                yield
            finally:
                if writable:
                    _restore_smn_index(fd, saved)
                fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)


def _governor_state(properties: dict, now: float) -> str:
    """"starting"/"restarting" while Cyan may be mid-message on Queue 3, else ""."""
    if properties.get("LoadState") != "loaded":
        return ""
    restarts = str(properties.get("NRestarts") or "0")
    label = "restarting" if restarts.isdecimal() and int(restarts) > 0 else "starting"
    if properties.get("SubState") == "auto-restart" or properties.get("ActiveState") in {
        "activating",
        "deactivating",
        "reloading",
    }:
        return label
    if properties.get("ActiveState") != "active":
        return ""
    started = str(properties.get("ExecMainStartTimestampMonotonic") or "0")
    if started.isdecimal() and int(started) and now - int(started) / 1e6 < GOVERNOR_SETTLE_SECONDS:
        return label
    return ""


def governor_unsettled() -> str:
    """Ask systemd whether Cyan is starting; "" when it is not (or not there)."""
    systemctl = next(
        (path for path in ("/usr/bin/systemctl", "/bin/systemctl") if os.path.exists(path)), ""
    )
    if not systemctl:
        return ""
    try:
        result = subprocess.run(
            [
                systemctl,
                "show",
                GOVERNOR_UNIT,
                "--property=LoadState,ActiveState,SubState,NRestarts,"
                "ExecMainStartTimestampMonotonic",
            ],
            text=True,
            capture_output=True,
            check=False,
            timeout=5,
            env={"PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C"},
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if result.returncode != 0:
        return ""
    properties = dict(
        line.split("=", 1) for line in result.stdout.splitlines() if "=" in line
    )
    return _governor_state(properties, time.clock_gettime(time.CLOCK_MONOTONIC))


class ExternalCollectorActive(RuntimeError):
    """BC250-Telemetry's memory collector owns the SMU right now."""


def _refuse_interrupted_collector(runtime: pathlib.Path) -> None:
    guard = runtime / "patch-state.json"
    try:
        state = json.loads(guard.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return
    except (OSError, ValueError):
        state = {"state": "unreadable"}
    if state in EXTERNAL_GUARD_BENIGN:
        return
    label = state.get("state") if isinstance(state, dict) else None
    raise RuntimeError(
        "GDDR6_EXTERNAL_INTERRUPTED: BC250-Telemetry's memory collector stopped "
        f"in the middle of an SMU operation this boot (state: {label or 'unknown'}). "
        "The firmware may still be running it, so the SMU is left alone until "
        "the board is powered off completely."
    )


@contextlib.contextmanager
def external_collector_lock(
    runtime: pathlib.Path = EXTERNAL_COLLECTOR_RUNTIME,
    markers: tuple[pathlib.Path, ...] = EXTERNAL_COLLECTOR_MARKERS,
    *,
    owner: int = 0,
):
    """Take BC250-Telemetry's collector lock for as long as the SMU is in use.

    Yields ``False`` when that collector is not installed: there is nothing to
    coordinate with. Raises ``ExternalCollectorActive`` when it is running,
    because it keeps the lock for its whole life and the only safe move is
    not to touch the SMU. Holding the lock also stops the collector from
    starting in the middle of this helper's own sample; it then reports that
    another collector owns the SMU and exits without touching anything.
    """
    if not runtime.exists() and not any(marker.exists() for marker in markers):
        yield False
        return
    if not runtime.exists():
        # The service is installed but has not run this boot. Its lock has to
        # exist for the collector to find it taken, so create the directory
        # exactly as systemd's RuntimeDirectory= would.
        runtime.mkdir(mode=0o755)
    info = runtime.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != owner or info.st_mode & 0o022:
        raise RuntimeError(
            f"GDDR6_EXTERNAL_UNTRUSTED: {runtime} is not a directory only root can "
            "write; refusing to coordinate through it."
        )
    fd = os.open(
        runtime / "smu.lock",
        os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o644,
    )
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != owner:
            raise RuntimeError(
                "GDDR6_EXTERNAL_UNTRUSTED: BC250-Telemetry's SMU lock is not a "
                "root-owned file; refusing to coordinate through it."
            )
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ExternalCollectorActive(
                "BC250-Telemetry's memory collector is sampling the SMU."
            ) from None
        try:
            _refuse_interrupted_collector(runtime)
            yield True
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


def _run(command: list[str], *, timeout: int = 30, uid: int, gid: int) -> str:
    result = subprocess.run(
        command,
        text=True,
        capture_output=True,
        check=False,
        timeout=timeout,
        user=uid,
        group=gid,
        env={
            "PATH": "/usr/bin:/bin",
            "LANG": "C",
            "LC_ALL": "C",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
        },
    )
    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip() or result.stdout.strip() or f"Command failed: {command[0]}"
        )
    return result.stdout.strip()


def _invoking_user() -> tuple[int, int, pathlib.Path]:
    value = os.environ.get("PKEXEC_UID", "")
    if not value.isdecimal():
        raise RuntimeError("The invoking desktop user could not be identified through Polkit.")
    uid = int(value)
    if uid <= 0:
        raise RuntimeError("This action must be requested by a non-root desktop user.")
    account = pwd.getpwuid(uid)
    return uid, account.pw_gid, pathlib.Path(account.pw_dir).resolve()


def _bc250_identity_present() -> bool:
    for path in (
        pathlib.Path("/proc/cpuinfo"),
        pathlib.Path("/sys/class/dmi/id/board_name"),
        pathlib.Path("/sys/class/dmi/id/product_name"),
    ):
        try:
            if "bc-250" in path.read_text(encoding="utf-8", errors="ignore").lower():
                return True
        except OSError:
            continue
    return False


def _validate_repository(raw_path: str, uid: int, gid: int, home: pathlib.Path) -> pathlib.Path:
    """Require an exact, clean, reviewed checkout owned by the invoking user."""
    requested = pathlib.Path(raw_path)
    if not requested.is_absolute():
        raise RuntimeError("The upstream repository path must be absolute.")
    try:
        repository = requested.resolve(strict=True)
        repository.relative_to(home)
    except (OSError, ValueError) as error:
        raise RuntimeError("The upstream repository must be inside the invoking user's home.") from error
    if repository.name != REPOSITORY_NAME or requested.is_symlink():
        raise RuntimeError("The selected path is not the expected bc250-memory-temperature clone.")

    git_dir = repository / ".git"
    if not git_dir.is_dir() or git_dir.is_symlink():
        raise RuntimeError("The bc250-memory-temperature directory is not a Git clone.")

    git = [
        "/usr/bin/git",
        "-c", f"safe.directory={repository}",
        "-c", "core.hooksPath=/dev/null",
        "-C", str(repository),
    ]
    origin = _run(git + ["remote", "get-url", "origin"], uid=uid, gid=gid)
    if origin not in OFFICIAL_ORIGINS:
        raise RuntimeError(f"Unexpected bc250-memory-temperature origin: {origin}")
    if _run(git + ["status", "--porcelain", "--untracked-files=all"], uid=uid, gid=gid):
        raise RuntimeError(
            "The bc250-memory-temperature clone has local modifications; update or restore it first."
        )
    head = _run(git + ["rev-parse", "HEAD"], uid=uid, gid=gid)
    if head != REVIEWED_REVISION:
        raise RuntimeError("The bc250-memory-temperature clone is not at the reviewed immutable revision.")
    return repository


def _require_user_owned(metadata: os.stat_result, name: str, uid: int) -> None:
    """The same per-file ownership guard the other helpers use."""
    if metadata.st_uid != uid or metadata.st_mode & 0o022:
        raise RuntimeError(
            f"{name} must belong to the desktop user and not be writable by group or others."
        )


def _read_checkout_file(root_fd: int, name: str, uid: int) -> bytes:
    """One file of the checkout, reached through no symbolic link at any level.

    ``O_NONBLOCK`` keeps a FIFO left in a file's place from hanging a root
    process at ``open``; it changes nothing for a regular file.
    """
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK
    *directories, leaf = name.split("/")
    opened: list[int] = []
    try:
        parent = root_fd
        for directory in directories:
            parent = os.open(directory, flags | os.O_DIRECTORY, dir_fd=parent)
            opened.append(parent)
            _require_user_owned(os.fstat(parent), directory, uid)
        fd = os.open(leaf, flags, dir_fd=parent)
        opened.append(fd)
        metadata = os.fstat(fd)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > STAGED_FILE_MAX_BYTES:
            raise RuntimeError(f"{name} in the reviewed checkout is not a regular file.")
        _require_user_owned(metadata, name, uid)
        return os.read(fd, metadata.st_size + 1)
    except OSError as error:
        raise RuntimeError(
            f"{name} was not found in the reviewed checkout, or is behind a symbolic link."
        ) from error
    finally:
        for fd in reversed(opened):
            os.close(fd)


@contextlib.contextmanager
def staged_checkout(repository: pathlib.Path, uid: int, reviewed: dict[str, str]):
    """Yield a private copy of the ``reviewed`` files, each one its reviewed bytes.

    The checkout belongs to the desktop user, so whatever was validated there
    holds only until that user's next write. An open fd does not change that:
    it pins the inode, and the owner can still rewrite its bytes in place.
    patch_smu.py then imports ``unlock`` and ``bc250_smu`` and reads the
    payload by path, from its own directory. Nor does a clean ``git status``
    mean only reviewed code is there: upstream ignores ``__pycache__``, and
    git ignores whatever ``.git/info/exclude`` names. So root takes nothing
    from the checkout but bytes: each file is read once, compared with its
    pinned SHA-256 and written into a fresh directory only root can enter.
    The script runs from there, and the directory is removed on the way out.
    """
    staging = pathlib.Path(tempfile.mkdtemp(prefix="bc250-gddr6-patch-", dir=STAGING_PARENT))
    try:
        try:
            root_fd = os.open(
                repository, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
            )
        except OSError as error:
            raise RuntimeError("The reviewed checkout could not be opened.") from error
        try:
            for name, expected in reviewed.items():
                content = _read_checkout_file(root_fd, name, uid)
                if hashlib.sha256(content).hexdigest() != expected:
                    raise RuntimeError(
                        f"{name} does not match the independently reviewed payload."
                    )
                target = staging / name
                target.parent.mkdir(mode=0o700, exist_ok=True)
                fd = os.open(
                    target,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                    0o600,
                )
                with open(fd, "wb") as handle:
                    handle.write(content)
        finally:
            os.close(root_fd)
        yield staging
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def _trusted_self() -> bool:
    """Refuse to run from a copy the system does not own (see the other helpers)."""
    path = pathlib.Path(__file__).resolve()
    prefixes = ("/usr/libexec/", "/usr/local/libexec/", "/usr/lib/")
    if not str(path).startswith(prefixes):
        return True
    for part in (path, *path.parents):
        try:
            info = part.lstat()
        except OSError:
            return False
        if stat.S_ISLNK(info.st_mode):
            return False
        if info.st_uid != 0 or info.st_mode & 0o022:
            return False
        if str(part) == path.anchor:
            break
    return True


def _reviewed_files() -> dict[str, str]:
    """Everything patch_smu.py runs, imports or reads, with its pinned SHA-256."""
    return {**REVIEWED_SCRIPT_SHA256, **REVIEWED_MODULE_SHA256, **REVIEWED_ARTIFACT_SHA256}


def _patch_status(repository: pathlib.Path, uid: int, *, ignore_governor: bool) -> dict:
    """What the reader finds installed, before deciding how to patch."""
    return _read_once(
        _installed_reader(), repository, uid, "status", ignore_governor=ignore_governor
    )


def kernel_driver_loaded(module: pathlib.Path | None = None) -> bool:
    """Whether the kernel's own bc250_memory driver owns the SMU patch."""
    return (module or KERNEL_DRIVER_MODULE).is_dir()


def _patch_arguments(status: dict) -> tuple[str, ...] | None:
    """patch_smu.py's arguments for what is installed, or None: nothing to do.

    Raises when patching must not be attempted at all.
    """
    if status.get("kernel_driver"):
        return None
    if status.get("external_collector"):
        raise ExternalCollectorActive("BC250-Telemetry's memory collector is sampling the SMU.")
    if status.get("deferred"):
        raise RuntimeError(
            "GDDR6_GOVERNOR_UNSETTLED: the GPU governor is "
            f"{status.get('governor_state') or 'starting'} and uses the SMU queue this "
            "patch goes through while it does. Try again once it is running."
        )
    installed = str(status.get("payload") or "")
    if installed == "unknown":
        raise RuntimeError(
            "GDDR6_PATCH_UNKNOWN: Queue 3 already points into the payload area, but "
            "not at a payload this version recognises (or one that did not finish "
            "installing). Power the board off completely before trying again."
        )
    if installed == "current" or status.get("patch_active"):
        # The reviewed payload, or the first one kept for BC250-Telemetry.
        return None
    # The first payload waits for a chip with no time limit; the reviewed one
    # replaces it under both locks, so no message can reach it mid-write.
    return (FORCE_FLAG,) if installed == "legacy" else ()


def _do_apply(
    repository: pathlib.Path,
    uid: int,
    gid: int,
    *,
    ignore_governor: bool = False,
    status: dict | None = None,
) -> int:
    if kernel_driver_loaded():
        print(
            "The kernel's bc250_memory driver installs and reads the SMU patch "
            "itself; Control Center reads its sensors instead of patching."
        )
        return 0
    detected = bios_version()
    if detected.strip().lower() not in SUPPORTED_BIOS_VERSIONS:
        raise RuntimeError(
            "GDDR6_FIRMWARE_UNSUPPORTED: the reviewed SMU payload targets board "
            f"firmware P3.0; this board reports {detected or 'an unknown version'}. "
            "Writing it here could place the patch at the wrong addresses."
        )
    try:
        with staged_checkout(repository, uid, _reviewed_files()) as staging:
            if status is None:
                status = _patch_status(repository, uid, ignore_governor=ignore_governor)
            arguments = _patch_arguments(status)
            if arguments is None:
                print("The runtime SMU patch is already active for this boot.")
                return 0
            # Held across the whole patch run: the payload is written one 32-bit
            # word at a time, and another SMU client redirecting the window
            # mid-write would scatter it across the wrong addresses.
            with external_collector_lock(), smn_window_lock():
                # The user's manual override (Settings) skips only this check;
                # both locks above are still held for the whole patch run.
                governor = "" if ignore_governor else governor_unsettled()
                if governor:
                    raise RuntimeError(
                        f"GDDR6_GOVERNOR_UNSETTLED: the GPU governor is {governor} and uses "
                        "the SMU queue this patch goes through while it does. Try again "
                        "once it is running."
                    )
                # The staged copy, by path: patch_smu.py finds unlock,
                # bc250_smu and the payload next to its own __file__. -I keeps
                # every other directory off sys.path, so nothing outside the
                # copy can stand in for a module it imports.
                result = subprocess.run(
                    ["/usr/bin/python3", "-I", str(staging / PATCH_SCRIPT), *arguments],
                    text=True,
                    capture_output=True,
                    check=False,
                    timeout=30,
                    cwd=str(staging),
                    env={
                        "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
                        "LANG": "C", "LC_ALL": "C",
                    },
                )
    except ExternalCollectorActive:
        raise RuntimeError(
            "GDDR6_EXTERNAL_COLLECTOR: BC250-Telemetry's memory collector already "
            "patched the SMU and is reading these chips. Control Center shows its "
            "readings instead of patching again."
        ) from None
    if result.stdout:
        print(result.stdout.rstrip())
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "The official patch_smu.py tool failed.")
    print(
        "Runtime SMU patch applied. This lives in volatile SMU RAM only; a full "
        "power cycle restores the factory Queue 3 handlers."
    )
    return 0


def _installed_reader() -> str:
    """Locate the packaged read-only helper, refusing anything unowned."""
    for candidate in (
        pathlib.Path("/usr/libexec/bc250-control-center/bc250-gddr6-temp-reader"),
        pathlib.Path("/usr/local/libexec/bc250-control-center/bc250-gddr6-temp-reader"),
    ):
        try:
            metadata = candidate.stat(follow_symlinks=False)
        except OSError:
            continue
        if candidate.is_symlink() or not candidate.is_file():
            continue
        if metadata.st_uid != 0 or metadata.st_mode & 0o022:
            continue
        if os.access(candidate, os.X_OK):
            return str(candidate)
    raise RuntimeError(
        "The GDDR6 reader helper is not installed. Reinstall BC250 Control Center."
    )


def _read_once(
    reader: str,
    repository: pathlib.Path,
    uid: int,
    action: str,
    *,
    ignore_governor: bool = False,
) -> dict:
    """Run the read-only helper as the already-authenticated root session.

    Delegating rather than duplicating: the reader owns the reviewed import,
    the ownership checks and the SMU window lock, and this process is already
    root, so no second Polkit prompt is involved.
    """
    arguments = [reader, "--repo", str(repository), "--action", action]
    if ignore_governor:
        arguments.append("--ignore-governor")
    result = subprocess.run(
        arguments,
        text=True,
        capture_output=True,
        check=False,
        timeout=60,
        env={
            "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
            "LANG": "C", "LC_ALL": "C",
            "PKEXEC_UID": str(uid),
        },
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "The GDDR6 reader failed.")
    try:
        return json.loads(result.stdout)
    except ValueError as error:
        raise RuntimeError("The GDDR6 reader returned invalid JSON.") from error


def _do_monitor(
    repository: pathlib.Path,
    uid: int,
    gid: int,
    seconds: float,
    *,
    ignore_governor: bool = False,
) -> int:
    """One authenticated session: patch if needed, then sample until it ends.

    This exists so live monitoring costs a single Polkit prompt instead of one
    per sample. The session is deliberately bounded: it stops on its own when
    the budget runs out rather than holding an authenticated root process open
    for as long as a window happens to be left on screen.
    """
    reader = _installed_reader()
    status = _read_once(
        reader, repository, uid, "status", ignore_governor=ignore_governor
    )
    # An external collector owns the SMU and has its own patch in place: the
    # reader relays its readings, and patching here would only race it.
    # A deferred status could not look (the GPU governor was starting); the
    # samples below find out, and patching now would only race the governor.
    if (
        not status.get("external_collector")
        and not status.get("deferred")
        and not status.get("patch_active")
    ):
        _do_apply(repository, uid, gid, ignore_governor=ignore_governor, status=status)

    deadline = time.monotonic() + max(0.0, float(seconds))
    while True:
        sample = _read_once(
            reader, repository, uid, "read", ignore_governor=ignore_governor
        )
        sample["session_remaining_s"] = max(0, round(deadline - time.monotonic()))
        print(json.dumps(sample), flush=True)
        if not (
            sample.get("patch_active")
            or sample.get("external_collector")
            or sample.get("deferred")
        ):
            # The patch went away underneath us; sampling cannot recover.
            break
        if sample.get("blocked_reason") == "GDDR6_NO_CHIP_ANSWERED":
            # Every chip timed out. Each one held the SMU for the payload's
            # whole wait, so stop asking rather than repeat that every few
            # seconds; the user can start again.
            raise RuntimeError(
                "GDDR6_NO_CHIP_ANSWERED: no memory chip answered, so live monitoring "
                "stopped. Try again later; if it keeps happening, power the board off "
                "completely."
            )
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        time.sleep(min(MONITOR_INTERVAL_SECONDS, remaining))

    print(json.dumps({"session_ended": True}), flush=True)
    return 0


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        raise RuntimeError("This helper must be launched through pkexec.")
    if not _trusted_self():
        raise RuntimeError(
            "HELPER_UNTRUSTED: this helper is not a root-owned, non-writable "
            "installed payload. Reinstall BC250 Control Center."
        )
    if len(argv) < 5 or argv[1] != "--repo" or argv[3] != "--action":
        raise RuntimeError("Expected: --repo PATH --action {apply,monitor} [--seconds N]")
    action = argv[4]
    if action not in {"apply", "monitor"}:
        raise RuntimeError(f"Unsupported action: {action}")
    # The manual override from Settings, always last when present.
    ignore_governor = argv[-1] == "--ignore-governor" and len(argv) > 5
    if ignore_governor:
        argv = argv[:-1]
    seconds = MONITOR_SECONDS
    if len(argv) > 5:
        if len(argv) != 7 or argv[5] != "--seconds":
            raise RuntimeError("Expected: --seconds N after the action.")
        try:
            seconds = float(argv[6])
        except ValueError as error:
            raise RuntimeError("--seconds must be a number.") from error
        if not 0 < seconds <= MONITOR_SECONDS_MAX:
            raise RuntimeError(
                f"--seconds must be between 1 and {MONITOR_SECONDS_MAX}."
            )
    if not _bc250_identity_present():
        raise RuntimeError("AMD BC-250 hardware identity was not detected.")
    uid, gid, home = _invoking_user()
    if kernel_driver_loaded():
        # Nothing of the checkout is imported or run: the kernel reads.
        repository = pathlib.Path(argv[2])
    else:
        if not pathlib.Path("/usr/bin/git").is_file():
            raise RuntimeError("git is required to validate the official upstream clone.")
        repository = _validate_repository(argv[2], uid, gid, home)

    if action == "monitor":
        return _do_monitor(
            repository, uid, gid, seconds, ignore_governor=ignore_governor
        )
    return _do_apply(repository, uid, gid, ignore_governor=ignore_governor)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except Exception as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(1)
