#!/usr/bin/python3 -I
"""Narrow privileged launcher for the official bc250-core-unlock tool."""
from __future__ import annotations

import contextlib
import hashlib
import os
import pathlib
import pwd
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

REPOSITORY_NAME = "bc250-core-unlock"
OFFICIAL_ORIGINS = frozenset({
    "https://github.com/rw-r-r-0644/bc250-core-unlock",
    "https://github.com/rw-r-r-0644/bc250-core-unlock.git",
})
UPSTREAM_SCRIPT = "bc250-unlock-cores.py"
REVIEWED_REVISION = "fb7e5bceab0e38369006cd1a0e53b768517f6030"
REVIEWED_SCRIPT_SHA256 = "b52bdcc14012c9dd222ebc71b4df11c3e976824a129f01f026bcc38c5482ccc5"
# The upstream tool writes nothing when the core presence mask is not the usual
# 0x77: a different mask usually means the factory disabled cores that failed.
# Its own "-f" skips that check. This helper passes it only when the owner
# ticked the box for it, and never on its own.
IGNORE_CORE_MASK = "--ignore-core-mask"
#: Where the verified script is copied before it runs: a fresh directory under
#: it that only root can enter (see ``_staged_script``).
STAGING_PARENT = "/run"
GOVERNOR_SERVICES = (
    "cyan-skillfish-governor-smu.service",
    "oberon-governor.service",
)


def _run(
    command: list[str],
    *,
    timeout: int = 30,
    uid: int | None = None,
    gid: int | None = None,
) -> str:
    result = subprocess.run(
        command,
        text=True,
        capture_output=True,
        check=False,
        timeout=timeout,
        user=uid,
        group=gid,
        env={
            "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
            "LANG": "C",
            "LC_ALL": "C",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
        },
    )
    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip()
            or result.stdout.strip()
            or f"Command failed: {command[0]}"
        )
    return result.stdout.strip()


def _invoking_user() -> tuple[int, int, Path]:
    value = os.environ.get("PKEXEC_UID", "")
    if not value.isdecimal():
        raise RuntimeError("The invoking desktop user could not be identified through Polkit.")
    uid = int(value)
    if uid <= 0:
        raise RuntimeError("CPU core unlock must be requested by a non-root desktop user.")
    account = pwd.getpwuid(uid)
    return uid, account.pw_gid, Path(account.pw_dir).resolve()


def _validate_repository(raw_path: str, uid: int, gid: int, home: Path) -> bytes:
    """The reviewed script's bytes, read once from a clean, reviewed checkout."""
    requested = Path(raw_path)
    if not requested.is_absolute():
        raise RuntimeError("The upstream repository path must be absolute.")
    try:
        repository = requested.resolve(strict=True)
        repository.relative_to(home)
    except (OSError, ValueError) as error:
        raise RuntimeError("The upstream repository must be inside the invoking user's home.") from error
    if repository.name != REPOSITORY_NAME or requested.is_symlink():
        raise RuntimeError("The selected path is not the expected bc250-core-unlock clone.")

    git_dir = repository / ".git"
    script = repository / UPSTREAM_SCRIPT
    if not git_dir.is_dir() or git_dir.is_symlink():
        raise RuntimeError("The bc250-core-unlock directory is not a Git clone.")
    if script.is_symlink() or not script.is_file():
        raise RuntimeError("The official bc250-unlock-cores.py script was not found.")

    git = [
        "/usr/bin/git",
        "-c",
        f"safe.directory={repository}",
        "-c",
        "core.hooksPath=/dev/null",
        "-C",
        str(repository),
    ]
    origin = _run(git + ["remote", "get-url", "origin"], uid=uid, gid=gid)
    if origin not in OFFICIAL_ORIGINS:
        raise RuntimeError(f"Unexpected bc250-core-unlock origin: {origin}")
    if _run(git + ["status", "--porcelain", "--untracked-files=all"], uid=uid, gid=gid):
        raise RuntimeError("The bc250-core-unlock clone has local modifications; update or restore it first.")
    head = _run(git + ["rev-parse", "HEAD"], uid=uid, gid=gid)
    if head != REVIEWED_REVISION:
        raise RuntimeError("The bc250-core-unlock clone is not at the reviewed immutable revision.")

    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(script, flags)
    try:
        metadata = os.fstat(fd)
        if metadata.st_uid != uid or metadata.st_mode & 0o022:
            raise RuntimeError(
                "The upstream script must belong to the desktop user and not be writable by group or others."
            )
        working_bytes = os.read(fd, metadata.st_size + 1)
    finally:
        os.close(fd)
    committed_bytes = subprocess.run(
        git + ["show", f"{head}:{UPSTREAM_SCRIPT}"],
        capture_output=True,
        check=False,
        timeout=15,
        user=uid,
        group=gid,
        env={
            "PATH": "/usr/bin:/bin",
            "LANG": "C",
            "LC_ALL": "C",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
        },
    )
    if committed_bytes.returncode != 0:
        raise RuntimeError("The committed upstream script could not be read.")
    working_hash = hashlib.sha256(working_bytes).hexdigest()
    committed_hash = hashlib.sha256(committed_bytes.stdout).hexdigest()
    if working_hash != REVIEWED_SCRIPT_SHA256 or committed_hash != REVIEWED_SCRIPT_SHA256:
        raise RuntimeError("The opened upstream script does not match the independently reviewed payload.")
    return working_bytes


@contextlib.contextmanager
def _staged_script(content: bytes):
    """Yield the verified bytes as a file only root can reach, removed afterwards.

    Running the checkout's own file, even through an fd, runs whatever its
    owner, the desktop user, writes into it after the hash check: the fd pins
    the inode, not its bytes. And Python put the checkout's directory first on
    sys.path, where a ``struct.py`` that ``.git/info/exclude`` hides from
    ``git status`` was imported in place of the standard module.
    """
    staging = pathlib.Path(tempfile.mkdtemp(prefix="bc250-core-unlock-", dir=STAGING_PARENT))
    try:
        script = staging / UPSTREAM_SCRIPT
        fd = os.open(
            script, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600
        )
        with open(fd, "wb") as handle:
            handle.write(content)
        yield script
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def _bc250_identity_present() -> bool:
    for path in (
        Path("/proc/cpuinfo"),
        Path("/sys/class/dmi/id/board_name"),
        Path("/sys/class/dmi/id/product_name"),
    ):
        try:
            if "bc-250" in path.read_text(encoding="utf-8", errors="ignore").lower():
                return True
        except OSError:
            continue
    return False


#: One governor this helper stopped: (unit, "systemd" | "openrc", was
#: enabled, was running). Kept so a run that ends before any SMU message can
#: put every governor back exactly as it was, and no more.
GovernorState = tuple[str, str, bool, bool]


def _stop_gpu_governors() -> tuple[GovernorState, ...]:
    """Stop every supported frequency governor before the upstream SMU write.

    The current upstream README explicitly requires Cyan to be stopped. Oberon
    also sends SMU frequency/voltage commands, so the dual-backend control
    center applies the same conservative exclusion while the raw mailbox
    operation runs. Missing units are ignored; an installed unit that cannot
    be disabled is a hard stop, and the ones already stopped are put back.
    """
    stopped: list[GovernorState] = []
    try:
        _stop_each_gpu_governor(stopped)
    except Exception:
        _restore_gpu_governors(tuple(stopped))
        raise
    return tuple(stopped)


def _stop_each_gpu_governor(stopped: list[GovernorState]) -> None:
    openrc = bool(
        Path('/run/openrc/softlevel').exists()
        and shutil.which('openrc-run')
        and shutil.which('rc-service')
        and shutil.which('rc-update')
    )
    for service in GOVERNOR_SERVICES:
        if openrc:
            key = service.removesuffix('.service')
            script = Path('/etc/init.d') / key
            if not script.is_file() or script.is_symlink():
                continue
            was_enabled = (Path('/etc/runlevels/default') / key).exists()
            was_active = subprocess.run(
                ['rc-service', key, 'status'],
                text=True, capture_output=True, check=False, timeout=10,
            ).returncode == 0
            # Do not delete an upstream-managed service here.  Core unlock is
            # volatile; it merely removes both governors from the active
            # OpenRC runlevel before the raw SMU action.
            subprocess.run(
                ['rc-update', 'del', key, 'default'],
                text=True, capture_output=True, check=False, timeout=20,
            )
            result = subprocess.run(
                ['rc-service', key, 'stop'],
                text=True, capture_output=True, check=False, timeout=20,
            )
            active = subprocess.run(
                ['rc-service', key, 'status'],
                text=True, capture_output=True, check=False, timeout=10,
            )
            if active.returncode == 0:
                raise RuntimeError(f'{key} is still active; upstream core unlock was not attempted.')
            if result.returncode not in {0, 1, 3}:  # OpenRC uses nonzero for already stopped.
                raise RuntimeError(result.stderr.strip() or result.stdout.strip() or f'{key} could not be stopped.')
            stopped.append((key, "openrc", was_enabled, was_active))
            continue
        load = subprocess.run(
            ["/usr/bin/systemctl", "show", "--property", "LoadState", "--value", service],
            text=True,
            capture_output=True,
            check=False,
            timeout=10,
        )
        if load.returncode != 0 or load.stdout.strip() in {"", "not-found"}:
            continue
        was_enabled = subprocess.run(
            ["/usr/bin/systemctl", "is-enabled", "--quiet", service],
            check=False,
            timeout=10,
        ).returncode == 0
        was_active = subprocess.run(
            ["/usr/bin/systemctl", "is-active", "--quiet", service],
            check=False,
            timeout=10,
        ).returncode == 0
        result = subprocess.run(
            ["/usr/bin/systemctl", "disable", "--now", service],
            text=True,
            capture_output=True,
            check=False,
            timeout=20,
        )
        if result.returncode != 0:
            raise RuntimeError(
                result.stderr.strip()
                or result.stdout.strip()
                or f"{service} could not be stopped and disabled."
            )
        active = subprocess.run(
            ["/usr/bin/systemctl", "is-active", "--quiet", service],
            check=False,
            timeout=10,
        )
        if active.returncode == 0:
            raise RuntimeError(
                f"{service} is still active; upstream core unlock was not attempted."
            )
        stopped.append((service, "systemd", was_enabled, was_active))


def _restore_gpu_governors(stopped: tuple[GovernorState, ...]) -> list[str]:
    """Enable and start again what was enabled and running; return any failures."""
    failed: list[str] = []
    for unit, init, was_enabled, was_running in stopped:
        if init == "openrc":
            enable, start = ['rc-update', 'add', unit, 'default'], ['rc-service', unit, 'start']
        else:
            enable = ["/usr/bin/systemctl", "enable", unit]
            start = ["/usr/bin/systemctl", "start", unit]
        commands = ([enable] if was_enabled else []) + ([start] if was_running else [])
        for command in commands:
            # A restore that fails is reported by name; it must never replace
            # the error that brought us here.
            try:
                result = subprocess.run(command, text=True, capture_output=True, check=False, timeout=30)
            except (OSError, subprocess.SubprocessError):
                result = None
            if result is None or result.returncode != 0:
                failed.append(unit)
                break
    return failed


#: Upstream output proving it stopped before any SMU message: it refused the
#: core mask, or it never got as far as reading it. Anything else may have
#: reached the mailbox, where upstream's own advice is to abort, not retry.
UPSTREAM_REFUSED_MASK = "non-0x77 presence mask detected"
UPSTREAM_READ_MASK = "core presence mask:"


def _stopped_before_smu_write(stdout: str, stderr: str) -> bool:
    return UPSTREAM_REFUSED_MASK in stderr or UPSTREAM_READ_MASK not in stdout


def _upstream_failure(stopped: tuple[GovernorState, ...], reason: str, *, before_smu_write: bool) -> RuntimeError:
    """The error to report, after putting the governors back when that is safe."""
    if not before_smu_write:
        return RuntimeError(
            reason + "\nThe GPU governors stay disabled: the SMU may have received the request. "
            "Power the board off completely, then enable the governor again from the GPU page."
        )
    failed = _restore_gpu_governors(stopped)
    if failed:
        return RuntimeError(
            reason + "\nNothing was written to the SMU, but these GPU governors could not be "
            "restored: " + ", ".join(failed) + ". Enable them again from the GPU page."
        )
    if stopped:
        reason += "\nNothing was written to the SMU; the GPU governors are back as they were."
    return RuntimeError(reason)


def _reboot_after_core_unlock() -> None:
    """Reboot through the active init system without assuming systemd."""
    openrc = bool(Path('/run/openrc/softlevel').exists() and shutil.which('openrc-run'))
    command = ['/usr/bin/systemctl', 'reboot']
    if openrc:
        reboot = next(
            (path for path in ('/sbin/reboot', '/usr/sbin/reboot', '/bin/reboot', '/usr/bin/reboot') if Path(path).is_file()),
            '',
        )
        if not reboot:
            raise RuntimeError('OpenRC reboot command was not found after core unlock.')
        command = [reboot]
    _run(command, timeout=30)


def _trusted_self() -> bool:
    """Refuse to run from a copy the system does not own.

    Every other helper in this directory checks this; these two did not. The
    check is about the *installed* path: if this file, or any directory above
    it, is a symbolic link or is writable by anyone but root, then whatever is
    executing here is not necessarily what the package installed — and it is
    executing as root.

    A run straight from a source checkout is normal during development, so a
    file outside the installed prefixes is left alone; the guard applies where
    the packaged helper lives.
    """
    path = pathlib.Path(__file__).resolve()
    prefixes = ('/usr/libexec/', '/usr/local/libexec/', '/usr/lib/')
    if not str(path).startswith(prefixes):
        return True
    for part in (path, *path.parents):
        try:
            info = part.lstat()
        except OSError:
            return False
        if stat.S_ISLNK(info.st_mode):
            return False
        if info.st_uid != 0 or info.st_mode & 0o022:
            return False
        if str(part) == path.anchor:
            break
    return True


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        raise RuntimeError("This helper must be launched through pkexec.")
    if not _trusted_self():
        raise RuntimeError(
            "HELPER_UNTRUSTED: this helper is not a root-owned, non-writable "
            "installed payload. Reinstall BC250 Control Center."
        )
    arguments = argv[1:]
    ignore_core_mask = arguments[-1:] == [IGNORE_CORE_MASK]
    if ignore_core_mask:
        arguments = arguments[:-1]
    if len(arguments) != 3 or arguments[0] != "--repo" or arguments[2] != "--reboot":
        raise RuntimeError(f"Expected exactly: --repo PATH --reboot [{IGNORE_CORE_MASK}]")
    if not _bc250_identity_present():
        raise RuntimeError("AMD BC-250 hardware identity was not detected.")
    if not Path("/usr/bin/git").is_file():
        raise RuntimeError("git is required to validate the official upstream clone.")

    uid, gid, home = _invoking_user()
    script_bytes = _validate_repository(arguments[1], uid, gid, home)
    with _staged_script(script_bytes) as script:
        stopped_governors = _stop_gpu_governors()

        if ignore_core_mask:
            print("Core mask check skipped at the owner's request (upstream -f).")
        try:
            # -I: the staged copy's directory is not put on sys.path either.
            result = subprocess.run(
                ["/usr/bin/python3", "-I", str(script), *(("-f",) if ignore_core_mask else ())],
                text=True,
                capture_output=True,
                check=False,
                timeout=30,
                cwd=str(script.parent),
                env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C", "LC_ALL": "C"},
            )
        except OSError as error:
            # The interpreter never started, so nothing reached the SMU.
            raise _upstream_failure(
                stopped_governors,
                f"The official upstream core unlock tool could not start: {error}",
                before_smu_write=True,
            ) from error
        if result.stdout:
            print(result.stdout.rstrip())
        if result.returncode != 0:
            # A refused core mask used to leave the GPU governor disabled with
            # no reboot coming: the GPU ran unmanaged until the owner noticed.
            raise _upstream_failure(
                stopped_governors,
                result.stderr.strip() or "The official upstream core unlock tool failed.",
                before_smu_write=_stopped_before_smu_write(result.stdout, result.stderr),
            )

    print("Executed official upstream tool: rw-r-r-0644/bc250-core-unlock")
    if stopped_governors:
        print("Disabled GPU governors: " + ", ".join(unit for unit, *_ in stopped_governors))
    print("The GPU frequency governor is disabled. Enable the selected backend manually from GPU after reboot.")
    _reboot_after_core_unlock()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except Exception as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(1)
