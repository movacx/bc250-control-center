#!/usr/bin/python3 -I
"""Narrow privileged launcher for the official bc250-memory-temperature tool.

This helper never re-implements the upstream SMU/UMC protocol. It only
validates that a reviewed, unmodified checkout is present and then executes
the exact upstream script (read_temp.py for a read-only chip-temperature
sample, patch_smu.py for the runtime SMU patch) with root privileges.

The upstream implementation is reverse-engineered and, by its own author's
account, not fully verified: an incorrect SMU/UMC state, DQ mapping, timing
or firmware address could interfere with GDDR6 traffic and cause memory
corruption, instability or crashes. Nothing here changes that risk; this
helper only decides *whether* and *by whom* the reviewed code may run.
"""
from __future__ import annotations

import hashlib
import os
import pathlib
import pwd
import stat
import subprocess
import sys


REPOSITORY_NAME = "bc250-memory-temperature"
OFFICIAL_ORIGINS = frozenset({
    "https://github.com/pan-Rijovich/bc250-memory-temperature",
    "https://github.com/pan-Rijovich/bc250-memory-temperature.git",
})
REVIEWED_REVISION = "b7e6bffcb5d592fc03edde375b7598ddc79aa846"
PATCH_SCRIPT = "patch_smu.py"
PAYLOAD_FILE = "SMUPayload.bin"
REVIEWED_SCRIPT_SHA256 = {
    PATCH_SCRIPT: "c6c0b17f3f2dad415f7814035a1918331068ab1827269a97254df0ddb554ca6e",
}


def _run(command: list[str], *, timeout: int = 30, uid: int, gid: int) -> str:
    result = subprocess.run(
        command,
        text=True,
        capture_output=True,
        check=False,
        timeout=timeout,
        user=uid,
        group=gid,
        env={
            "PATH": "/usr/bin:/bin",
            "LANG": "C",
            "LC_ALL": "C",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
        },
    )
    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip() or result.stdout.strip() or f"Command failed: {command[0]}"
        )
    return result.stdout.strip()


def _invoking_user() -> tuple[int, int, pathlib.Path]:
    value = os.environ.get("PKEXEC_UID", "")
    if not value.isdecimal():
        raise RuntimeError("The invoking desktop user could not be identified through Polkit.")
    uid = int(value)
    if uid <= 0:
        raise RuntimeError("This action must be requested by a non-root desktop user.")
    account = pwd.getpwuid(uid)
    return uid, account.pw_gid, pathlib.Path(account.pw_dir).resolve()


def _bc250_identity_present() -> bool:
    for path in (
        pathlib.Path("/proc/cpuinfo"),
        pathlib.Path("/sys/class/dmi/id/board_name"),
        pathlib.Path("/sys/class/dmi/id/product_name"),
    ):
        try:
            if "bc-250" in path.read_text(encoding="utf-8", errors="ignore").lower():
                return True
        except OSError:
            continue
    return False


def _validate_repository(raw_path: str, uid: int, gid: int, home: pathlib.Path) -> pathlib.Path:
    """Require an exact, clean, reviewed checkout owned by the invoking user."""
    requested = pathlib.Path(raw_path)
    if not requested.is_absolute():
        raise RuntimeError("The upstream repository path must be absolute.")
    try:
        repository = requested.resolve(strict=True)
        repository.relative_to(home)
    except (OSError, ValueError) as error:
        raise RuntimeError("The upstream repository must be inside the invoking user's home.") from error
    if repository.name != REPOSITORY_NAME or requested.is_symlink():
        raise RuntimeError("The selected path is not the expected bc250-memory-temperature clone.")

    git_dir = repository / ".git"
    if not git_dir.is_dir() or git_dir.is_symlink():
        raise RuntimeError("The bc250-memory-temperature directory is not a Git clone.")

    git = [
        "/usr/bin/git",
        "-c", f"safe.directory={repository}",
        "-c", "core.hooksPath=/dev/null",
        "-C", str(repository),
    ]
    origin = _run(git + ["remote", "get-url", "origin"], uid=uid, gid=gid)
    if origin not in OFFICIAL_ORIGINS:
        raise RuntimeError(f"Unexpected bc250-memory-temperature origin: {origin}")
    if _run(git + ["status", "--porcelain", "--untracked-files=all"], uid=uid, gid=gid):
        raise RuntimeError(
            "The bc250-memory-temperature clone has local modifications; update or restore it first."
        )
    head = _run(git + ["rev-parse", "HEAD"], uid=uid, gid=gid)
    if head != REVIEWED_REVISION:
        raise RuntimeError("The bc250-memory-temperature clone is not at the reviewed immutable revision.")
    return repository


def _open_verified_script(repository: pathlib.Path, name: str, uid: int, gid: int) -> int:
    """Open one reviewed script by fd, after checking ownership and content hash."""
    script = repository / name
    if script.is_symlink() or not script.is_file():
        raise RuntimeError(f"The official {name} script was not found.")

    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(script, flags)
    metadata = os.fstat(fd)
    if metadata.st_uid != uid or metadata.st_mode & 0o022:
        os.close(fd)
        raise RuntimeError(
            f"{name} must belong to the desktop user and not be writable by group or others."
        )
    working_bytes = os.read(fd, metadata.st_size + 1)

    git = [
        "/usr/bin/git",
        "-c", f"safe.directory={repository}",
        "-C", str(repository),
    ]
    committed = subprocess.run(
        git + ["show", f"{REVIEWED_REVISION}:{name}"],
        capture_output=True,
        check=False,
        timeout=15,
        user=uid,
        group=gid,
        env={
            "PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C",
            "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_NOSYSTEM": "1",
        },
    )
    if committed.returncode != 0:
        os.close(fd)
        raise RuntimeError(f"The committed {name} could not be read.")

    expected = REVIEWED_SCRIPT_SHA256[name]
    working_hash = hashlib.sha256(working_bytes).hexdigest()
    committed_hash = hashlib.sha256(committed.stdout).hexdigest()
    if working_hash != expected or committed_hash != expected:
        os.close(fd)
        raise RuntimeError(f"The opened {name} does not match the independently reviewed payload.")
    os.lseek(fd, 0, os.SEEK_SET)
    return fd


def _trusted_self() -> bool:
    """Refuse to run from a copy the system does not own (see the other helpers)."""
    path = pathlib.Path(__file__).resolve()
    prefixes = ("/usr/libexec/", "/usr/local/libexec/", "/usr/lib/")
    if not str(path).startswith(prefixes):
        return True
    for part in (path, *path.parents):
        try:
            info = part.lstat()
        except OSError:
            return False
        if stat.S_ISLNK(info.st_mode):
            return False
        if info.st_uid != 0 or info.st_mode & 0o022:
            return False
        if str(part) == path.anchor:
            break
    return True


def _do_check(repository: pathlib.Path) -> int:
    print("VERIFIED: bc250-memory-temperature is a clean, reviewed checkout.")
    print(f"Reviewed revision: {REVIEWED_REVISION}")
    return 0


def _verify_package_ownership(repository: pathlib.Path, uid: int) -> pathlib.Path:
    """Require the reviewed bc250_smu package to be owned by the desktop user.

    The git origin/revision/clean-tree check already pins every tracked
    file's exact content; this adds the same per-file ownership guard the
    other helpers use before loading anything outside the standard library.
    """
    package_dir = repository / "bc250_smu"
    if package_dir.is_symlink() or not package_dir.is_dir():
        raise RuntimeError("The bc250_smu package was not found in the reviewed checkout.")
    for path in (package_dir, *package_dir.rglob("*.py")):
        if path.is_symlink():
            raise RuntimeError("bc250_smu must not contain symbolic links.")
        metadata = path.stat(follow_symlinks=False)
        if metadata.st_uid != uid or metadata.st_mode & 0o022:
            raise RuntimeError(
                "bc250_smu package files must belong to the desktop user and not be "
                "writable by group or others."
            )
    return package_dir


def _do_read(repository: pathlib.Path, uid: int, gid: int) -> int:
    """Read all 8 GDDR6 chip temperatures via the reviewed Bc250Smu class.

    read_temp.py itself additionally requires the third-party ``tabulate``
    package purely to draw its ASCII table; that is not something this
    root-owned helper should depend on being installed system-wide. This
    calls the exact same reviewed primitive read_temp.py calls
    (``Bc250Smu.send_message(3, 0x5, [chip])``) and formats the result
    itself, without altering the SMU protocol logic at all.
    """
    _verify_package_ownership(repository, uid)
    sys.path.insert(0, str(repository))
    try:
        from bc250_smu import Bc250Smu  # noqa: PLC0415
    except Exception as error:
        raise RuntimeError(f"Could not import the reviewed bc250_smu package: {error}") from error

    smu = Bc250Smu()
    try:
        rows = []
        temperatures = []
        for chip in range(8):
            temp_readout = smu.send_message(3, 0x5, [chip])[1]
            temp_c = ((temp_readout & 0xFF) * 2) - 40
            temperatures.append(temp_c)
            rows.append((chip, temp_readout, temp_readout & 0xFF, temp_c))
    finally:
        smu.close()

    print(f"{'Chip':>4} | {'MR3 raw':<10} | {'Temp code':<9} | Temperature")
    for chip, raw, code, temp_c in rows:
        print(f"{chip:>4} | 0x{raw:08X} | 0x{code:02X}       | {temp_c:.1f} \u00b0C")
    average = sum(temperatures) / len(temperatures)
    hotspot = max(temperatures)
    hotspot_chip = temperatures.index(hotspot)
    print()
    print(f"Average : {average:.1f} \u00b0C")
    print(f"Hotspot : {hotspot:.1f} \u00b0C (Chip {hotspot_chip})")
    return 0


def _do_apply(repository: pathlib.Path, uid: int, gid: int) -> int:
    payload = repository / PAYLOAD_FILE
    if payload.is_symlink() or not payload.is_file():
        raise RuntimeError(f"{PAYLOAD_FILE} was not found in the reviewed checkout.")
    metadata = payload.stat(follow_symlinks=False)
    if metadata.st_uid != uid or metadata.st_mode & 0o022:
        raise RuntimeError(f"{PAYLOAD_FILE} must belong to the desktop user and not be group/other writable.")

    script_fd = _open_verified_script(repository, PATCH_SCRIPT, uid, gid)
    try:
        result = subprocess.run(
            ["/usr/bin/python3", f"/proc/self/fd/{script_fd}"],
            text=True,
            capture_output=True,
            check=False,
            timeout=30,
            pass_fds=(script_fd,),
            cwd=str(repository),
            env={
                "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
                "LANG": "C", "LC_ALL": "C",
                "PYTHONPATH": str(repository),
            },
        )
    finally:
        os.close(script_fd)
    if result.stdout:
        print(result.stdout.rstrip())
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "The official patch_smu.py tool failed.")
    print(
        "Runtime SMU patch applied. This lives in volatile SMU RAM only; a full "
        "power cycle restores the factory Queue 3 / Message 5 handler."
    )
    return 0


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        raise RuntimeError("This helper must be launched through pkexec.")
    if not _trusted_self():
        raise RuntimeError(
            "HELPER_UNTRUSTED: this helper is not a root-owned, non-writable "
            "installed payload. Reinstall BC250 Control Center."
        )
    if len(argv) != 5 or argv[1] != "--repo" or argv[3] != "--action":
        raise RuntimeError("Expected exactly: --repo PATH --action {check,read,apply}")
    action = argv[4]
    if action not in {"check", "read", "apply"}:
        raise RuntimeError(f"Unsupported action: {action}")
    if not _bc250_identity_present():
        raise RuntimeError("AMD BC-250 hardware identity was not detected.")
    if not pathlib.Path("/usr/bin/git").is_file():
        raise RuntimeError("git is required to validate the official upstream clone.")

    uid, gid, home = _invoking_user()
    repository = _validate_repository(argv[2], uid, gid, home)

    if action == "check":
        return _do_check(repository)
    if action == "read":
        return _do_read(repository, uid, gid)
    return _do_apply(repository, uid, gid)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except Exception as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(1)
