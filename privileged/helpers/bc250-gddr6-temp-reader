REPOSITORY_NAME = "bc250-memory-temperature"

#: Every SMU client on this board drives one shared indirect transaction
#: through the root complex's PCI config space: register 0xB8 selects the SMN
#: address, 0xBC carries the data. The pair is not atomic, so a second client
#: that redirects 0xB8 in between makes the first one read or write the wrong
#: register. The packaged CPU OC tool (bc250_smu_oc) already guards against
#: that with an advisory lock on this exact file; the reviewed upstream
#: bc250_smu package does not take it, so this helper holds it around every
#: SMU access on its behalf. Advisory locking only works if every participant
#: asks, which is why this is not optional.
SMN_WINDOW_PATH = "/sys/bus/pci/devices/0000:00:00.0/config"
#: Taken exclusively by the CPU tuning helper for a whole run, shared and for
#: one sample at a time here. See ``smu_run_share``.
SMU_RUN_LOCK_PATH = "/run/bc250-smu-run.lock"
SMN_LOCK_TIMEOUT_SECONDS = 8.0

#: The window's index register. The CPU OC tool and the Cyan GPU governor take
#: the lock above around each 32-bit access, not around the index/data pair,
#: so one of them can have selected a register and be waiting for the lock to
#: touch its data when this helper takes it. Left pointing at this helper's
#: last register, 0xB8 would send that pending access there instead, so the
#: lock saves the index on entry and puts it back on exit.
SMN_INDEX_OFFSET = 0xB8
#: Selecting a register is harmless on its own: nothing is read or written
#: until the data register is touched. The lock selects this one (Queue 3's
#: response register) and reads it back before trusting the index it saved.
SMN_INDEX_PROBE = 0x03B10A80

#: Cyan, the GPU governor, uses Queue 3 -- the mailbox these readings go
#: through -- only while it starts: a test message, then the GPU temperature
#: limit. It locks each 32-bit access rather than each message, so a sample
#: taken in the middle of that start mixes the two messages' words: the
#: payload gets Cyan's argument as a chip index and never returns, or Cyan's
#: temperature limit becomes a chip number. With Fix metrics on a kernel
#: that has no gpu_metrics file, Cyan fails and restarts every few seconds,
#: which is exactly when memory temperatures started hanging boards.
GOVERNOR_UNIT = "cyan-skillfish-governor-smu.service"
#: How long after its process starts Cyan may still be sending those two.
GOVERNOR_SETTLE_SECONDS = 5.0

#: BC250-Telemetry (github.com/onlinermm/BC250-Telemetry) can install an
#: optional root service, bc250-memory.service, that patches the SMU with the
#: first version of this payload at boot and then polls Queue 3 / Message 5
#: every three seconds.
#: It serialises itself with its own lock file, never with SMN_WINDOW_PATH, so
#: the two samplers used to run straight into each other: interleaved
#: index/data writes land in the wrong registers, the payload is handed a chip
#: index outside 0-7, derives a UMC address from it and waits forever for an
#: answer that never comes. The SMU stops responding and the board goes down.
#: That collector holds its lock for as long as it runs, so this helper takes
#: the same lock while it touches the SMU, and when the collector already owns
#: it, relays the collector's published reading instead of sampling again.
EXTERNAL_COLLECTOR_RUNTIME = pathlib.Path("/run/bc250-memory")
EXTERNAL_COLLECTOR_MARKERS = (
    pathlib.Path("/etc/systemd/system/bc250-memory.service"),
    pathlib.Path("/opt/bc250-memory/collector.py"),
)
#: The collector's own rule for its per-boot guard file: anything but a clean
#: "ready" means an SMU operation was interrupted and its firmware side may
#: still be running, so it leaves the SMU alone until a power cycle. This
#: helper follows the same rule. The exceptions are rejections raised after
#: reads only, before anything was written: one its later version migrates
#: itself, and the three it gives when it finds the payload this helper
#: installs (or one written over its own) instead of the one it bundles.
EXTERNAL_GUARD_BENIGN = (
    {"state": "ready"},
    {"state": "failed", "error": "unexpected original Q3/5 handler: 0x00000000"},
    {"state": "failed", "error": "unexpected original Q3/5 handler: 0x0003ab34"},
    {"state": "failed", "error": "SMU patch changed during this boot; reboot before retrying"},
    {"state": "failed", "error": "Q3/5 points at an unexpected payload; reboot before retrying"},
)
#: Where that collector's reading is published for other programs.
EXTERNAL_TELEMETRY_PATH = pathlib.Path("/run/apu_telemetry.json")
#: Its daemon rewrites the file every ~700 ms; older than this, it is not
#: running and the file is a photograph, not a reading.
EXTERNAL_TELEMETRY_MAX_AGE_SECONDS = 5.0
#: JEDEC MR3 temperature codes run 0..80 (80 means "at least 120 °C").
MR3_CODE_MAX = 80

