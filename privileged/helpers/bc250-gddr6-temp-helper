#!/usr/bin/python3 -I
"""Narrow privileged launcher for the official bc250-memory-temperature patch.

This helper never re-implements the upstream SMU/UMC protocol. It only
validates that a reviewed, unmodified checkout is present and then executes
the exact upstream ``patch_smu.py`` with root privileges.

Reading is deliberately *not* here: it lives in ``bc250-gddr6-temp-reader``,
a binary with no write path at all, so the read action can use a cached
Polkit grant while this one — which unlocks the SMU debug gate and writes
into SMU memory — keeps an uncached ``auth_admin``.

The upstream implementation is reverse-engineered and, by its own author's
account, not fully verified: an incorrect SMU/UMC state, DQ mapping, timing
or firmware address could interfere with GDDR6 traffic and cause memory
corruption, instability or crashes. Nothing here changes that risk; this
helper only decides *whether* and *by whom* the reviewed code may run.
"""
from __future__ import annotations

import contextlib
import fcntl
import hashlib
import json
import os
import pathlib
import pwd
import stat
import subprocess
import sys
import time

REPOSITORY_NAME = "bc250-memory-temperature"

#: Every SMU client on this board drives one shared indirect transaction
#: through the root complex's PCI config space: register 0xB8 selects the SMN
#: address, 0xBC carries the data. The pair is not atomic, so a second client
#: that redirects 0xB8 in between makes the first one read or write the wrong
#: register. The packaged CPU OC tool already guards this exact file with an
#: advisory lock; the reviewed upstream patch_smu.py does not, so this helper
#: holds it for the whole run on its behalf. That matters far more here than
#: for a read: this writes a payload word by word into SMU memory.
SMN_WINDOW_PATH = "/sys/bus/pci/devices/0000:00:00.0/config"
SMN_LOCK_TIMEOUT_SECONDS = 8.0

#: A monitoring session is bounded on purpose. One Polkit prompt buys this
#: much live sampling and no more: an authenticated root process that samples
#: for as long as a window is left open is a far bigger commitment than the
#: user agreed to, and the SMU is shared with the GPU governor and the CPU
#: overclocking tool. When it expires the user presses the button again.
MONITOR_SECONDS = 600.0
MONITOR_SECONDS_MAX = 1800.0
MONITOR_INTERVAL_SECONDS = 5.0


OFFICIAL_ORIGINS = frozenset({
    "https://github.com/pan-Rijovich/bc250-memory-temperature",
    "https://github.com/pan-Rijovich/bc250-memory-temperature.git",
})
REVIEWED_REVISION = "b7e6bffcb5d592fc03edde375b7598ddc79aa846"
PATCH_SCRIPT = "patch_smu.py"
PAYLOAD_FILE = "SMUPayload.bin"
REVIEWED_SCRIPT_SHA256 = {
    PATCH_SCRIPT: "c6c0b17f3f2dad415f7814035a1918331068ab1827269a97254df0ddb554ca6e",
}

#: The payload writes fixed SMU addresses that are only correct for the board
#: firmware it was built against. The upstream README is explicit: "Do not use
#: the SMU patch with a different firmware version unless the relevant
#: addresses and payload have been verified."
SUPPORTED_BIOS_VERSIONS = frozenset({"p3.0", "p3.00"})


def bios_version() -> str:
    try:
        return pathlib.Path("/sys/class/dmi/id/bios_version").read_text(
            encoding="utf-8", errors="ignore"
        ).strip()
    except OSError:
        return ""


@contextlib.contextmanager
def smn_window_lock(timeout: float = SMN_LOCK_TIMEOUT_SECONDS):
    """Hold the advisory lock the other SMU clients on this board honour."""
    fd = os.open(SMN_WINDOW_PATH, os.O_RDONLY | os.O_CLOEXEC)
    deadline = time.monotonic() + max(0.0, float(timeout))
    try:
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    raise RuntimeError(
                        "SMU_BUSY: another BC-250 tool is holding the SMU interface "
                        "(CPU overclocking or the GPU governor). Wait for it to "
                        "finish and try again."
                    ) from None
                time.sleep(0.05)
        try:
            yield
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)
def _run(command: list[str], *, timeout: int = 30, uid: int, gid: int) -> str:
    result = subprocess.run(
        command,
        text=True,
        capture_output=True,
        check=False,
        timeout=timeout,
        user=uid,
        group=gid,
        env={
            "PATH": "/usr/bin:/bin",
            "LANG": "C",
            "LC_ALL": "C",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
        },
    )
    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip() or result.stdout.strip() or f"Command failed: {command[0]}"
        )
    return result.stdout.strip()


def _invoking_user() -> tuple[int, int, pathlib.Path]:
    value = os.environ.get("PKEXEC_UID", "")
    if not value.isdecimal():
        raise RuntimeError("The invoking desktop user could not be identified through Polkit.")
    uid = int(value)
    if uid <= 0:
        raise RuntimeError("This action must be requested by a non-root desktop user.")
    account = pwd.getpwuid(uid)
    return uid, account.pw_gid, pathlib.Path(account.pw_dir).resolve()


def _bc250_identity_present() -> bool:
    for path in (
        pathlib.Path("/proc/cpuinfo"),
        pathlib.Path("/sys/class/dmi/id/board_name"),
        pathlib.Path("/sys/class/dmi/id/product_name"),
    ):
        try:
            if "bc-250" in path.read_text(encoding="utf-8", errors="ignore").lower():
                return True
        except OSError:
            continue
    return False


def _validate_repository(raw_path: str, uid: int, gid: int, home: pathlib.Path) -> pathlib.Path:
    """Require an exact, clean, reviewed checkout owned by the invoking user."""
    requested = pathlib.Path(raw_path)
    if not requested.is_absolute():
        raise RuntimeError("The upstream repository path must be absolute.")
    try:
        repository = requested.resolve(strict=True)
        repository.relative_to(home)
    except (OSError, ValueError) as error:
        raise RuntimeError("The upstream repository must be inside the invoking user's home.") from error
    if repository.name != REPOSITORY_NAME or requested.is_symlink():
        raise RuntimeError("The selected path is not the expected bc250-memory-temperature clone.")

    git_dir = repository / ".git"
    if not git_dir.is_dir() or git_dir.is_symlink():
        raise RuntimeError("The bc250-memory-temperature directory is not a Git clone.")

    git = [
        "/usr/bin/git",
        "-c", f"safe.directory={repository}",
        "-c", "core.hooksPath=/dev/null",
        "-C", str(repository),
    ]
    origin = _run(git + ["remote", "get-url", "origin"], uid=uid, gid=gid)
    if origin not in OFFICIAL_ORIGINS:
        raise RuntimeError(f"Unexpected bc250-memory-temperature origin: {origin}")
    if _run(git + ["status", "--porcelain", "--untracked-files=all"], uid=uid, gid=gid):
        raise RuntimeError(
            "The bc250-memory-temperature clone has local modifications; update or restore it first."
        )
    head = _run(git + ["rev-parse", "HEAD"], uid=uid, gid=gid)
    if head != REVIEWED_REVISION:
        raise RuntimeError("The bc250-memory-temperature clone is not at the reviewed immutable revision.")
    return repository


def _open_verified_script(repository: pathlib.Path, name: str, uid: int, gid: int) -> int:
    """Open one reviewed script by fd, after checking ownership and content hash."""
    script = repository / name
    if script.is_symlink() or not script.is_file():
        raise RuntimeError(f"The official {name} script was not found.")

    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(script, flags)
    metadata = os.fstat(fd)
    if metadata.st_uid != uid or metadata.st_mode & 0o022:
        os.close(fd)
        raise RuntimeError(
            f"{name} must belong to the desktop user and not be writable by group or others."
        )
    working_bytes = os.read(fd, metadata.st_size + 1)

    git = [
        "/usr/bin/git",
        "-c", f"safe.directory={repository}",
        "-C", str(repository),
    ]
    committed = subprocess.run(
        git + ["show", f"{REVIEWED_REVISION}:{name}"],
        capture_output=True,
        check=False,
        timeout=15,
        user=uid,
        group=gid,
        env={
            "PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C",
            "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_NOSYSTEM": "1",
        },
    )
    if committed.returncode != 0:
        os.close(fd)
        raise RuntimeError(f"The committed {name} could not be read.")

    expected = REVIEWED_SCRIPT_SHA256[name]
    working_hash = hashlib.sha256(working_bytes).hexdigest()
    committed_hash = hashlib.sha256(committed.stdout).hexdigest()
    if working_hash != expected or committed_hash != expected:
        os.close(fd)
        raise RuntimeError(f"The opened {name} does not match the independently reviewed payload.")
    os.lseek(fd, 0, os.SEEK_SET)
    return fd


def _trusted_self() -> bool:
    """Refuse to run from a copy the system does not own (see the other helpers)."""
    path = pathlib.Path(__file__).resolve()
    prefixes = ("/usr/libexec/", "/usr/local/libexec/", "/usr/lib/")
    if not str(path).startswith(prefixes):
        return True
    for part in (path, *path.parents):
        try:
            info = part.lstat()
        except OSError:
            return False
        if stat.S_ISLNK(info.st_mode):
            return False
        if info.st_uid != 0 or info.st_mode & 0o022:
            return False
        if str(part) == path.anchor:
            break
    return True


def _do_apply(repository: pathlib.Path, uid: int, gid: int) -> int:
    detected = bios_version()
    if detected.strip().lower() not in SUPPORTED_BIOS_VERSIONS:
        raise RuntimeError(
            "GDDR6_FIRMWARE_UNSUPPORTED: the reviewed SMU payload targets board "
            f"firmware P3.0; this board reports {detected or 'an unknown version'}. "
            "Writing it here could place the patch at the wrong addresses."
        )
    payload = repository / PAYLOAD_FILE
    if payload.is_symlink() or not payload.is_file():
        raise RuntimeError(f"{PAYLOAD_FILE} was not found in the reviewed checkout.")
    metadata = payload.stat(follow_symlinks=False)
    if metadata.st_uid != uid or metadata.st_mode & 0o022:
        raise RuntimeError(f"{PAYLOAD_FILE} must belong to the desktop user and not be group/other writable.")

    script_fd = _open_verified_script(repository, PATCH_SCRIPT, uid, gid)
    try:
        # Held across the whole patch run: the payload is written one 32-bit
        # word at a time, and another SMU client redirecting the window
        # mid-write would scatter it across the wrong addresses.
        with smn_window_lock():
            result = subprocess.run(
                ["/usr/bin/python3", f"/proc/self/fd/{script_fd}"],
                text=True,
                capture_output=True,
                check=False,
                timeout=30,
                pass_fds=(script_fd,),
                cwd=str(repository),
                env={
                    "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
                    "LANG": "C", "LC_ALL": "C",
                    "PYTHONPATH": str(repository),
                },
            )
    finally:
        os.close(script_fd)
    if result.stdout:
        print(result.stdout.rstrip())
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "The official patch_smu.py tool failed.")
    print(
        "Runtime SMU patch applied. This lives in volatile SMU RAM only; a full "
        "power cycle restores the factory Queue 3 / Message 5 handler."
    )
    return 0


def _installed_reader() -> str:
    """Locate the packaged read-only helper, refusing anything unowned."""
    for candidate in (
        pathlib.Path("/usr/libexec/bc250-control-center/bc250-gddr6-temp-reader"),
        pathlib.Path("/usr/local/libexec/bc250-control-center/bc250-gddr6-temp-reader"),
    ):
        try:
            metadata = candidate.stat(follow_symlinks=False)
        except OSError:
            continue
        if candidate.is_symlink() or not candidate.is_file():
            continue
        if metadata.st_uid != 0 or metadata.st_mode & 0o022:
            continue
        if os.access(candidate, os.X_OK):
            return str(candidate)
    raise RuntimeError(
        "The GDDR6 reader helper is not installed. Reinstall BC250 Control Center."
    )


def _read_once(reader: str, repository: pathlib.Path, uid: int, action: str) -> dict:
    """Run the read-only helper as the already-authenticated root session.

    Delegating rather than duplicating: the reader owns the reviewed import,
    the ownership checks and the SMU window lock, and this process is already
    root, so no second Polkit prompt is involved.
    """
    result = subprocess.run(
        [reader, "--repo", str(repository), "--action", action],
        text=True,
        capture_output=True,
        check=False,
        timeout=60,
        env={
            "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
            "LANG": "C", "LC_ALL": "C",
            "PKEXEC_UID": str(uid),
        },
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "The GDDR6 reader failed.")
    try:
        return json.loads(result.stdout)
    except ValueError as error:
        raise RuntimeError("The GDDR6 reader returned invalid JSON.") from error


def _do_monitor(
    repository: pathlib.Path, uid: int, gid: int, seconds: float
) -> int:
    """One authenticated session: patch if needed, then sample until it ends.

    This exists so live monitoring costs a single Polkit prompt instead of one
    per sample. The session is deliberately bounded: it stops on its own when
    the budget runs out rather than holding an authenticated root process open
    for as long as a window happens to be left on screen.
    """
    reader = _installed_reader()
    if not _read_once(reader, repository, uid, "status").get("patch_active"):
        _do_apply(repository, uid, gid)

    deadline = time.monotonic() + max(0.0, float(seconds))
    while True:
        sample = _read_once(reader, repository, uid, "read")
        sample["session_remaining_s"] = max(0, round(deadline - time.monotonic()))
        print(json.dumps(sample), flush=True)
        if not sample.get("patch_active"):
            # The patch went away underneath us; sampling cannot recover.
            break
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        time.sleep(min(MONITOR_INTERVAL_SECONDS, remaining))

    print(json.dumps({"session_ended": True}), flush=True)
    return 0


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        raise RuntimeError("This helper must be launched through pkexec.")
    if not _trusted_self():
        raise RuntimeError(
            "HELPER_UNTRUSTED: this helper is not a root-owned, non-writable "
            "installed payload. Reinstall BC250 Control Center."
        )
    if len(argv) < 5 or argv[1] != "--repo" or argv[3] != "--action":
        raise RuntimeError("Expected: --repo PATH --action {apply,monitor} [--seconds N]")
    action = argv[4]
    if action not in {"apply", "monitor"}:
        raise RuntimeError(f"Unsupported action: {action}")
    seconds = MONITOR_SECONDS
    if len(argv) > 5:
        if len(argv) != 7 or argv[5] != "--seconds":
            raise RuntimeError("Expected: --seconds N after the action.")
        try:
            seconds = float(argv[6])
        except ValueError as error:
            raise RuntimeError("--seconds must be a number.") from error
        if not 0 < seconds <= MONITOR_SECONDS_MAX:
            raise RuntimeError(
                f"--seconds must be between 1 and {MONITOR_SECONDS_MAX}."
            )
    if not _bc250_identity_present():
        raise RuntimeError("AMD BC-250 hardware identity was not detected.")
    if not pathlib.Path("/usr/bin/git").is_file():
        raise RuntimeError("git is required to validate the official upstream clone.")

    uid, gid, home = _invoking_user()
    repository = _validate_repository(argv[2], uid, gid, home)

    if action == "monitor":
        return _do_monitor(repository, uid, gid, seconds)
    return _do_apply(repository, uid, gid)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except Exception as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(1)
