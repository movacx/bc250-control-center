def gpu_pcie_link(drm_root: pathlib.Path = pathlib.Path("/sys/class/drm")) -> str:
    """The negotiated link, as "16.0 GT/s x16", or empty when unknown."""
    device = _amdgpu_device(drm_root)
    if device is None:
        return ""
    try:
        speed = (device / "current_link_speed").read_text(encoding="ascii", errors="ignore").strip()
        width = (device / "current_link_width").read_text(encoding="ascii", errors="ignore").strip()
    except OSError:
        return ""
    speed = speed.replace("PCIe", "").strip()
    if not speed or not width:
        return ""
    return f"{speed} x{width}"


