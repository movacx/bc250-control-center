def _run(command: list[str], *, timeout: int = 30, uid: int, gid: int) -> str:
    result = subprocess.run(
        command,
        text=True,
        capture_output=True,
        check=False,
        timeout=timeout,
        user=uid,
        group=gid,
        env={
            "PATH": "/usr/bin:/bin",
            "LANG": "C",
            "LC_ALL": "C",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
        },
    )
    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip() or result.stdout.strip() or f"Command failed: {command[0]}"
        )
    return result.stdout.strip()


def _invoking_user() -> tuple[int, int, pathlib.Path]:
    value = os.environ.get("PKEXEC_UID", "")
    if not value.isdecimal():
        raise RuntimeError("The invoking desktop user could not be identified through Polkit.")
    uid = int(value)
    if uid <= 0:
        raise RuntimeError("This action must be requested by a non-root desktop user.")
    account = pwd.getpwuid(uid)
    return uid, account.pw_gid, pathlib.Path(account.pw_dir).resolve()


def _bc250_identity_present() -> bool:
    for path in (
        pathlib.Path("/proc/cpuinfo"),
        pathlib.Path("/sys/class/dmi/id/board_name"),
        pathlib.Path("/sys/class/dmi/id/product_name"),
    ):
        try:
            if "bc-250" in path.read_text(encoding="utf-8", errors="ignore").lower():
                return True
        except OSError:
            continue
    return False


def bios_version() -> str:
    try:
        return pathlib.Path("/sys/class/dmi/id/bios_version").read_text(
            encoding="utf-8", errors="ignore"
        ).strip()
    except OSError:
        return ""


def firmware_supported() -> bool:
    return bios_version().strip().lower() in SUPPORTED_BIOS_VERSIONS


def _validate_repository(raw_path: str, uid: int, gid: int, home: pathlib.Path) -> pathlib.Path:
    """Require an exact, clean, reviewed checkout owned by the invoking user."""
    requested = pathlib.Path(raw_path)
    if not requested.is_absolute():
        raise RuntimeError("The upstream repository path must be absolute.")
    try:
        repository = requested.resolve(strict=True)
        repository.relative_to(home)
    except (OSError, ValueError) as error:
        raise RuntimeError(
            "The upstream repository must be inside the invoking user's home."
        ) from error
    if repository.name != REPOSITORY_NAME or requested.is_symlink():
        raise RuntimeError("The selected path is not the expected bc250-memory-temperature clone.")

    git_dir = repository / ".git"
    if not git_dir.is_dir() or git_dir.is_symlink():
        raise RuntimeError("The bc250-memory-temperature directory is not a Git clone.")

    git = [
        "/usr/bin/git",
        "-c", f"safe.directory={repository}",
        "-c", "core.hooksPath=/dev/null",
        "-C", str(repository),
    ]
    origin = _run(git + ["remote", "get-url", "origin"], uid=uid, gid=gid)
    if origin not in OFFICIAL_ORIGINS:
        raise RuntimeError(f"Unexpected bc250-memory-temperature origin: {origin}")
    if _run(git + ["status", "--porcelain", "--untracked-files=all"], uid=uid, gid=gid):
        raise RuntimeError(
            "The bc250-memory-temperature clone has local modifications; update or restore it first."
        )
    head = _run(git + ["rev-parse", "HEAD"], uid=uid, gid=gid)
    if head != REVIEWED_REVISION:
        raise RuntimeError(
            "The bc250-memory-temperature clone is not at the reviewed immutable revision."
        )
    return repository


def _require_user_owned(metadata: os.stat_result, name: str, uid: int) -> None:
    """The same per-file ownership guard the other helpers use."""
    if metadata.st_uid != uid or metadata.st_mode & 0o022:
        raise RuntimeError(
            f"{name} must belong to the desktop user and not be writable by group or others."
        )


def _read_checkout_file(root_fd: int, name: str, uid: int) -> bytes:
    """One file of the checkout, reached through no symbolic link at any level.

    ``O_NONBLOCK`` keeps a FIFO left in a file's place from hanging a root
    process at ``open``; it changes nothing for a regular file.
    """
    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK
    *directories, leaf = name.split("/")
    opened: list[int] = []
    try:
        parent = root_fd
        for directory in directories:
            parent = os.open(directory, flags | os.O_DIRECTORY, dir_fd=parent)
            opened.append(parent)
            _require_user_owned(os.fstat(parent), directory, uid)
        fd = os.open(leaf, flags, dir_fd=parent)
        opened.append(fd)
        metadata = os.fstat(fd)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_size > STAGED_FILE_MAX_BYTES:
            raise RuntimeError(f"{name} in the reviewed checkout is not a regular file.")
        _require_user_owned(metadata, name, uid)
        return os.read(fd, metadata.st_size + 1)
    except OSError as error:
        raise RuntimeError(
            f"{name} was not found in the reviewed checkout, or is behind a symbolic link."
        ) from error
    finally:
        for fd in reversed(opened):
            os.close(fd)


@contextlib.contextmanager
def staged_checkout(repository: pathlib.Path, uid: int, reviewed: dict[str, str]):
    """Yield a private copy of the ``reviewed`` files, each one its reviewed bytes.

    The checkout belongs to the desktop user, so whatever was validated there
    holds only until that user's next write: a file replaced afterwards would
    be imported as root. Nor does a clean ``git status`` mean only reviewed
    code is there: upstream ignores ``__pycache__``, and a bytecode file
    forged to match a source's size and time is imported in its place. So root
    takes nothing from the checkout but bytes: each file is read once,
    compared with its pinned SHA-256 and written into a fresh directory only
    root can enter. Everything is imported from there, and the directory is
    removed on the way out.
    """
    staging = pathlib.Path(tempfile.mkdtemp(prefix="bc250-gddr6-read-", dir=STAGING_PARENT))
    try:
        try:
            root_fd = os.open(
                repository, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
            )
        except OSError as error:
            raise RuntimeError("The reviewed checkout could not be opened.") from error
        try:
            for name, expected in reviewed.items():
                content = _read_checkout_file(root_fd, name, uid)
                if hashlib.sha256(content).hexdigest() != expected:
                    raise RuntimeError(
                        f"{name} does not match the independently reviewed payload."
                    )
                target = staging / name
                target.parent.mkdir(mode=0o700, exist_ok=True)
                fd = os.open(
                    target,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                    0o600,
                )
                with open(fd, "wb") as handle:
                    handle.write(content)
        finally:
            os.close(root_fd)
        yield staging
    finally:
        shutil.rmtree(staging, ignore_errors=True)


def _trusted_self() -> bool:
    """Refuse to run from a copy the system does not own (see the other helpers)."""
    path = pathlib.Path(__file__).resolve()
    prefixes = ("/usr/libexec/", "/usr/local/libexec/", "/usr/lib/")
    if not str(path).startswith(prefixes):
        return True
    for part in (path, *path.parents):
        try:
            info = part.lstat()
        except OSError:
            return False
        if stat.S_ISLNK(info.st_mode):
            return False
        if info.st_uid != 0 or info.st_mode & 0o022:
            return False
        if str(part) == path.anchor:
            break
    return True


def _open_smn_window(path: str) -> tuple[int, bool]:
    """Open the window writable when allowed, so its index can be restored."""
    try:
        return os.open(path, os.O_RDWR | os.O_CLOEXEC), True
    except PermissionError:
        return os.open(path, os.O_RDONLY | os.O_CLOEXEC), False


def _read_smn_index(fd: int) -> int | None:
    try:
        data = os.pread(fd, 4, SMN_INDEX_OFFSET)
    except OSError:
        return None
    return struct.unpack("<I", data)[0] if len(data) == 4 else None


def _restore_smn_index(fd: int, saved: int | None) -> None:
    """Put back the register another client selected before this one ran.

    Only once the index is proven to read back what is written: restoring a
    value the hardware never really reported would misdirect a pending
    access just as badly as not restoring at all.
    """
    if saved is None:
        return
    try:
        os.pwrite(fd, struct.pack("<I", SMN_INDEX_PROBE), SMN_INDEX_OFFSET)
        if _read_smn_index(fd) != SMN_INDEX_PROBE:
            return
        os.pwrite(fd, struct.pack("<I", saved), SMN_INDEX_OFFSET)
    except OSError:
        return


@contextlib.contextmanager
def smu_run_share(path: str | None = None):
    """Stand aside while the CPU tuning helper is using the SMU.

    A CPU detection or apply sends several multi-step messages on Queue 3, and
    its payload locks each 32-bit access rather than each message. A sample
    taken between two steps of one of those messages clears the response
    register or overwrites its argument, and the tuning reads
    ``smu returned status 0x00``. The helper therefore holds ``path``
    exclusively for the whole run; each sample here takes it shared and gives
    up at once when it is held, instead of waiting inside the run.
    """
    try:
        fd = os.open(
            path or SMU_RUN_LOCK_PATH,
            os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o644,
        )
    except OSError:
        # Cannot coordinate (for example a read-only /run): behave as before.
        yield
        return
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except OSError:
            raise RuntimeError(
                "SMU_BUSY: CPU overclocking is using the SMU right now. Wait for "
                "it to finish and try again."
            ) from None
        try:
            yield
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


@contextlib.contextmanager
def smn_window_lock(
    timeout: float = SMN_LOCK_TIMEOUT_SECONDS, path: str = SMN_WINDOW_PATH
):
    """Hold the advisory lock the other SMU clients on this board honour.

    Non-blocking with a deadline rather than a blocking ``flock``: the CPU OC
    tool can hold this for the length of a detection run, and a helper that
    waits forever would leave a Polkit-launched process hanging with no way
    for the desktop to explain why.
    """
    with smu_run_share():
        fd, writable = _open_smn_window(path)
        deadline = time.monotonic() + max(0.0, float(timeout))
        try:
            while True:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except OSError:
                    if time.monotonic() >= deadline:
                        raise RuntimeError(
                            "SMU_BUSY: another BC-250 tool is holding the SMU interface "
                            "(CPU overclocking or the GPU governor). Wait for it to "
                            "finish and try again."
                        ) from None
                    time.sleep(0.05)
            saved = _read_smn_index(fd) if writable else None
            try:
                yield
            finally:
                if writable:
                    _restore_smn_index(fd, saved)
                fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)


def _governor_state(properties: dict, now: float) -> str:
    """"starting"/"restarting" while Cyan may be mid-message on Queue 3, else ""."""
    if properties.get("LoadState") != "loaded":
        return ""
    restarts = str(properties.get("NRestarts") or "0")
    label = "restarting" if restarts.isdecimal() and int(restarts) > 0 else "starting"
    if properties.get("SubState") == "auto-restart" or properties.get("ActiveState") in {
        "activating",
        "deactivating",
        "reloading",
    }:
        return label
    if properties.get("ActiveState") != "active":
        return ""
    started = str(properties.get("ExecMainStartTimestampMonotonic") or "0")
    if started.isdecimal() and int(started) and now - int(started) / 1e6 < GOVERNOR_SETTLE_SECONDS:
        return label
    return ""


def governor_unsettled() -> str:
    """Ask systemd whether Cyan is starting; "" when it is not (or not there)."""
    systemctl = next(
        (path for path in ("/usr/bin/systemctl", "/bin/systemctl") if os.path.exists(path)), ""
    )
    if not systemctl:
        return ""
    try:
        result = subprocess.run(
            [
                systemctl,
                "show",
                GOVERNOR_UNIT,
                "--property=LoadState,ActiveState,SubState,NRestarts,"
                "ExecMainStartTimestampMonotonic",
            ],
            text=True,
            capture_output=True,
            check=False,
            timeout=5,
            env={"PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C"},
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if result.returncode != 0:
        return ""
    properties = dict(
        line.split("=", 1) for line in result.stdout.splitlines() if "=" in line
    )
    return _governor_state(properties, time.clock_gettime(time.CLOCK_MONOTONIC))


class ExternalCollectorActive(RuntimeError):
    """BC250-Telemetry's memory collector owns the SMU right now."""


def _refuse_interrupted_collector(runtime: pathlib.Path) -> None:
    guard = runtime / "patch-state.json"
    try:
        state = json.loads(guard.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return
    except (OSError, ValueError):
        state = {"state": "unreadable"}
    if state in EXTERNAL_GUARD_BENIGN:
        return
    label = state.get("state") if isinstance(state, dict) else None
    raise RuntimeError(
        "GDDR6_EXTERNAL_INTERRUPTED: BC250-Telemetry's memory collector stopped "
        f"in the middle of an SMU operation this boot (state: {label or 'unknown'}). "
        "The firmware may still be running it, so the SMU is left alone until "
        "the board is powered off completely."
    )


@contextlib.contextmanager
def external_collector_lock(
    runtime: pathlib.Path = EXTERNAL_COLLECTOR_RUNTIME,
    markers: tuple[pathlib.Path, ...] = EXTERNAL_COLLECTOR_MARKERS,
    *,
    owner: int = 0,
):
    """Take BC250-Telemetry's collector lock for as long as the SMU is in use.

    Yields ``False`` when that collector is not installed: there is nothing to
    coordinate with. Raises ``ExternalCollectorActive`` when it is running,
    because it keeps the lock for its whole life and the only safe move is
    not to touch the SMU. Holding the lock also stops the collector from
    starting in the middle of this helper's own sample; it then reports that
    another collector owns the SMU and exits without touching anything.
    """
    if not runtime.exists() and not any(marker.exists() for marker in markers):
        yield False
        return
    if not runtime.exists():
        # The service is installed but has not run this boot. Its lock has to
        # exist for the collector to find it taken, so create the directory
        # exactly as systemd's RuntimeDirectory= would.
        runtime.mkdir(mode=0o755)
    info = runtime.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != owner or info.st_mode & 0o022:
        raise RuntimeError(
            f"GDDR6_EXTERNAL_UNTRUSTED: {runtime} is not a directory only root can "
            "write; refusing to coordinate through it."
        )
    fd = os.open(
        runtime / "smu.lock",
        os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o644,
    )
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != owner:
            raise RuntimeError(
                "GDDR6_EXTERNAL_UNTRUSTED: BC250-Telemetry's SMU lock is not a "
                "root-owned file; refusing to coordinate through it."
            )
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ExternalCollectorActive(
                "BC250-Telemetry's memory collector is sampling the SMU."
            ) from None
        try:
            _refuse_interrupted_collector(runtime)
            yield True
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


def _external_chips(memory: dict) -> list[dict] | None:
    """The collector's eight readings in this reader's shape, or None."""
    if memory.get("valid") is not True:
        return None
    raw = memory.get("raw")
    if not isinstance(raw, list) or len(raw) != CHIP_COUNT:
        return None
    chips = []
    for index, word in enumerate(raw):
        if type(word) is not int or not 0 <= word <= 0xFFFFFFFF:
            return None
        code = word & 0xFF
        if code > MR3_CODE_MAX:
            return None
        chips.append({
            "chip": index,
            "raw": word,
            "code": code,
            "temperature_c": (code * 2) - 40,
        })
    return chips


def relay_external_sample(
    path: pathlib.Path = EXTERNAL_TELEMETRY_PATH,
    *,
    chips_wanted: bool = True,
    now: float | None = None,
) -> dict:
    """What BC250-Telemetry last published, without touching the SMU."""
    relay: dict = {
        "source": "bc250-telemetry",
        "external_collector": True,
        "external_status": "unavailable",
        "patch_active": False,
        "blocked_reason": "GDDR6_EXTERNAL_NO_SAMPLE",
        "chips": [],
    }
    payload: object = {}
    try:
        age = (time.time() if now is None else now) - path.stat().st_mtime
        if age <= EXTERNAL_TELEMETRY_MAX_AGE_SECONDS:
            payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        payload = {}
    memory = payload.get("memory") if isinstance(payload, dict) else None
    if not isinstance(memory, dict):
        return relay
    relay["external_status"] = str(memory.get("status") or "unavailable")
    chips = _external_chips(memory)
    if chips is None:
        return relay
    # The collector only samples once its patch is installed and verified.
    relay.update(patch_active=True, blocked_reason="")
    if chips_wanted:
        temperatures = [entry["temperature_c"] for entry in chips]
        hotspot = max(temperatures)
        relay.update(
            chips=chips,
            average_c=sum(temperatures) / len(temperatures),
            hotspot_c=hotspot,
            hotspot_chip=temperatures.index(hotspot),
        )
    return relay


def _open_smu(repository: pathlib.Path, uid: int):
    """The reviewed ``Bc250Smu``, imported from a private copy, never the checkout."""
    with staged_checkout(repository, uid, REVIEWED_PACKAGE_SHA256) as staging:
        sys.path.insert(0, str(staging))
        try:
            from bc250_smu import Bc250Smu  # noqa: PLC0415
        except Exception as error:
            raise RuntimeError(
                f"Could not import the reviewed bc250_smu package: {error}"
            ) from error
        finally:
            sys.path.remove(str(staging))
    return Bc250Smu()


def _handler_words(smu) -> tuple[int, int, int]:
    """Queue 3's handler fields for messages 5, 6 and 7, in one transfer.

    ``smu_read`` goes through the transfer engine (Queue 2), which is not part
    of the gated cluster ``unlock.py`` opens, so this stays a pure read.
    """
    first = QUEUE_3_HANDLER_TABLE + 5 * QUEUE_3_ENTRY_SIZE
    words = struct.unpack("<5I", smu.smu_read(first, 5)[:20])
    return words[0], words[2], words[4]


def _smu_bytes(smu, start: int, size: int) -> bytes:
    """``size`` bytes of SMU RAM, at most 18 words per transfer."""
    chunks = []
    for address in range(start, start + size, 72):
        words = min(18, (start + size - address) // 4)
        chunks.append(smu.smu_read(address, words)[: words * 4])
    return b"".join(chunks)


def _in_payload_area(address: int) -> bool:
    return PAYLOAD_START <= address < PAYLOAD_END


def _installed_payload(smu) -> str:
    """"current", "legacy", "unknown" (some other patch) or "" (none)."""
    handlers = _handler_words(smu)
    if handlers == CURRENT_HANDLERS:
        return "current"
    if (
        handlers[0] == LEGACY_HANDLER
        and not any(_in_payload_area(word) for word in handlers[1:])
        and hashlib.sha256(_smu_bytes(smu, PAYLOAD_START, LEGACY_PAYLOAD_SIZE)).hexdigest()
        == LEGACY_PAYLOAD_SHA256
    ):
        return "legacy"
    # A newer payload half-written over the old one, or one this version
    # does not know: sending it a message could run anything.
    if any(_in_payload_area(word) for word in handlers):
        return "unknown"
    return ""


def _chip_entry(chip: int, raw: int, code: int) -> dict:
    return {"chip": chip, "raw": raw, "code": code, "temperature_c": (code * 2) - 40}


def _sort_reading(chips: list[dict], errors: list[dict], chip: int, raw: int, code: int) -> None:
    """A valid JEDEC MR3 code joins ``chips``; anything else is reported, not shown."""
    if code <= MR3_CODE_MAX:
        chips.append(_chip_entry(chip, raw, code))
    else:
        errors.append({"chip": chip, "raw": raw, "error": CHIP_ERRORS.get(code, "out_of_range")})


def _packed_chips(smu) -> tuple[list[dict], list[dict]]:
    """Two messages, four chips each: parity 0 is chips 0/2/4/6, parity 1 the rest."""
    chips: list[dict] = []
    errors: list[dict] = []
    for parity in (0, 1):
        word = smu.send_message(3, MSG_READ_TEMP_PACKED, [parity])[1] & 0xFFFFFFFF
        for slot in range(4):
            code = (word >> (8 * slot)) & 0xFF
            _sort_reading(chips, errors, parity + 2 * slot, code, code)
    chips.sort(key=lambda entry: entry["chip"])
    errors.sort(key=lambda entry: entry["chip"])
    return chips, errors


def _legacy_chips(smu) -> tuple[list[dict], list[dict]]:
    """The first payload's message 5, one chip at a time."""
    chips: list[dict] = []
    errors: list[dict] = []
    for chip in range(CHIP_COUNT):
        raw = smu.send_message(3, 0x5, [chip])[1]
        _sort_reading(chips, errors, chip, raw, raw & 0xFF)
    return chips, errors


def _summarise(payload: dict, chips: list[dict], errors: list[dict]) -> None:
    payload["chips"] = chips
    if errors:
        payload["chip_errors"] = errors
    if not chips:
        payload["blocked_reason"] = "GDDR6_NO_CHIP_ANSWERED"
        return
    temperatures = [entry["temperature_c"] for entry in chips]
    hotspot = max(temperatures)
    payload.update({
        "average_c": sum(temperatures) / len(temperatures),
        "hotspot_c": hotspot,
        "hotspot_chip": chips[temperatures.index(hotspot)]["chip"],
    })


def _sample_smu(
    payload: dict,
    repository: pathlib.Path,
    uid: int,
    *,
    chips_wanted: bool,
    ignore_governor: bool = False,
    collector_installed: bool = False,
) -> None:
    """Fill ``payload`` from the SMU itself, holding the shared window lock."""
    # One lock for the whole sample, not one per message: consecutive
    # mailbox round trips interleaved with another client's transactions is
    # exactly the failure the lock exists to prevent.
    with smn_window_lock():
        # Checked with the lock held: a Cyan that starts after this blocks on
        # the lock at its first word and runs its messages after ours. The
        # user's manual override (Settings) skips only this check.
        governor = "" if ignore_governor else governor_unsettled()
        if governor:
            payload.update(
                deferred=True,
                blocked_reason="GDDR6_GOVERNOR_UNSETTLED",
                governor_state=governor,
            )
            return
        smu = _open_smu(repository, uid)
        try:
            installed = _installed_payload(smu)
            payload["payload"] = installed
            # The first payload stays in use only for BC250-Telemetry, whose
            # collector refuses to start over any other one.
            payload["patch_active"] = installed == "current" or (
                installed == "legacy" and collector_installed
            )
            if installed == "unknown":
                payload["blocked_reason"] = "GDDR6_PATCH_UNKNOWN"
            elif not payload["patch_active"]:
                # The handlers are provided by the runtime SMU payload, not by
                # the factory firmware: on an unpatched board these messages
                # would reach unknown stock handlers.
                payload["blocked_reason"] = "GDDR6_PATCH_INACTIVE"
            elif chips_wanted:
                chips, errors = (
                    _packed_chips(smu) if installed == "current" else _legacy_chips(smu)
                )
                _summarise(payload, chips, errors)
        finally:
            smu.close()


def _do_read(
    repository: pathlib.Path,
    uid: int,
    *,
    chips_wanted: bool,
    ignore_governor: bool = False,
) -> int:
    """Emit board/patch status and, when the patch is active, the chip table.

    One round trip on purpose. Every sample costs a Polkit check, so asking
    "is the patch active?" and "what are the temperatures?" separately would
    double the prompts for no gain. An inactive patch is a *state*, not a
    failure: it exits 0 with an empty chip list and a named reason, so the
    desktop can offer the patch button instead of reporting an error.

    read_temp.py is an endless terminal monitor that redraws the screen;
    that is not something a root-owned helper should run. This calls the
    exact same reviewed primitive read_temp.py calls and emits JSON instead.
    A chip that did not answer is listed under ``chip_errors`` and left out
    of ``chips``, the average and the hotspot.
    """
    payload: dict = {
        "bios_version": bios_version(),
        "firmware_supported": firmware_supported(),
        "reviewed_revision": REVIEWED_REVISION,
        "patch_active": False,
        "blocked_reason": "",
        "chips": [],
    }
    try:
        with external_collector_lock() as collector_installed:
            _sample_smu(
                payload,
                repository,
                uid,
                chips_wanted=chips_wanted,
                ignore_governor=ignore_governor,
                collector_installed=collector_installed,
            )
    except ExternalCollectorActive:
        # BC250-Telemetry is sampling these chips right now. A second sampler
        # on the same mailbox is what used to hang the SMU, so hand back what
        # that collector published instead of reading them again.
        payload.update(relay_external_sample(chips_wanted=chips_wanted))

    print(json.dumps(payload))
    return 0


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        raise RuntimeError("This helper must be launched through pkexec.")
    if not _trusted_self():
        raise RuntimeError(
            "HELPER_UNTRUSTED: this helper is not a root-owned, non-writable "
            "installed payload. Reinstall BC250 Control Center."
        )
    ignore_governor = len(argv) == 6 and argv[5] == "--ignore-governor"
    if ignore_governor:
        argv = argv[:5]
    if len(argv) != 5 or argv[1] != "--repo" or argv[3] != "--action":
        raise RuntimeError(
            "Expected exactly: --repo PATH --action {status,read} [--ignore-governor]"
        )
    action = argv[4]
    if action not in {"status", "read"}:
        raise RuntimeError(f"Unsupported action: {action}")
    if not _bc250_identity_present():
        raise RuntimeError("AMD BC-250 hardware identity was not detected.")
    if not pathlib.Path("/usr/bin/git").is_file():
        raise RuntimeError("git is required to validate the official upstream clone.")

    uid, gid, home = _invoking_user()
    repository = _validate_repository(argv[2], uid, gid, home)

    return _do_read(
        repository,
        uid,
        chips_wanted=action == "read",
        ignore_governor=ignore_governor,
    )


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except Exception as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise SystemExit(1)
