#!/usr/bin/env sh
set -eu
if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
  echo "BC250 Control Center needs Python 3.11 or newer; this system has $(python3 -V 2>&1 || echo 'no python3')." >&2
  exit 2
fi
XDG_DATA_BASE="${XDG_DATA_HOME:-$HOME/.local/share}"
# "bc250-control-center tui" opens the terminal interface instead of the window.
# "bc250-control-center web" starts the local web interface.
if [ "${1:-}" = "tui" ]; then
  shift
  APP_ENTRY="frontends/tui/app.py"
  APP_MODULE="frontends.tui"
elif [ "${1:-}" = "web" ]; then
  shift
  APP_ENTRY="frontends/web/server.py"
  APP_MODULE="frontends.web"
else
  APP_ENTRY="frontends/desktop/main.py"
  APP_MODULE="frontends.desktop.main"
fi
for APP_DIR in \
  "${BC250_CONTROL_CENTER_DIR:-}" \
  "${MODO_JUEGO_RAM_DIR:-}" \
  "$(CDPATH= cd -- "$(dirname -- "$0")/../share/bc250-control-center" 2>/dev/null && pwd || true)" \
  "$(CDPATH= cd -- "$(dirname -- "$0")/../.." 2>/dev/null && pwd || true)" \
  "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)" \
  "$XDG_DATA_BASE/bc250-control-center" \
  /usr/share/bc250-control-center \
  /usr/local/share/bc250-control-center; do
  if [ -n "$APP_DIR" ] && [ -f "$APP_DIR/$APP_ENTRY" ]; then
    cd "$APP_DIR"
    export PYTHONPATH="$APP_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
    exec python3 -m "$APP_MODULE" "$@"
  fi
done
echo "No se encontro la instalacion de BC250 Control Center" >&2
exit 1
