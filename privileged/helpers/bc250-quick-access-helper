@contextmanager
def operation_lock(path: pathlib.Path, label: str):
    flags = os.O_CREAT | os.O_RDWR | getattr(os, 'O_CLOEXEC', 0)
    flags |= getattr(os, 'O_NOFOLLOW', 0)
    descriptor = os.open(path, flags, 0o600)
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != 0
            or metadata.st_mode & 0o077
        ):
            raise RuntimeError(f'Unsafe {label} operation lock.')
        deadline = time.monotonic() + OPERATION_LOCK_TIMEOUT_SECONDS
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError(f'Another {label} operation is still in progress.')
                time.sleep(0.025)
        yield
    finally:
        os.close(descriptor)


def fail(message: str, code: int = 1) -> int:
    print(f"ERR {message}", file=sys.stderr, flush=True)
    return code


def trusted_cu_environment() -> dict[str, str]:
    """Use the distribution UMR database selected by the generic backend.

    SteamOS uses the reviewed static database staged below /usr/libexec.
    Passing that path on Bazzite would override its working rpm-ostree UMR
    installation, so the override is deliberately distribution-specific.
    """
    return (
        {"UMR_DATABASE_PATH": str(STEAMOS_CU_DATABASE)}
        if is_steamos()
        else {}
    )


def run(
    command: Sequence[str],
    *,
    timeout: int = 45,
    extra_env: Mapping[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    environment = {
        "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
    }
    if extra_env:
        environment.update({str(key): str(value) for key, value in extra_env.items()})
    return subprocess.run(
        list(command), text=True, capture_output=True,
        timeout=timeout, check=False,
        env=environment,
    )


def is_steamos() -> bool:
    for path in (pathlib.Path("/etc/os-release"), pathlib.Path("/usr/lib/os-release")):
        try:
            text = path.read_text(encoding="utf-8", errors="ignore").lower()
        except OSError:
            continue
        if any(marker in text for marker in ("id=steamos", "steamos", "steamdeck", "holo")):
            return True
    return False


def is_bazzite() -> bool:
    for path in (pathlib.Path("/etc/os-release"), pathlib.Path("/usr/lib/os-release")):
