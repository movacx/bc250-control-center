def gpu_voltage_mv(drm_root: pathlib.Path = pathlib.Path("/sys/class/drm")) -> int | None:
    """Read a labelled live VDDGFX value without assuming a hwmon index.

    A voltage input without the ``vddgfx`` label may belong to another rail,
    so it is intentionally ignored.  The hwmon ABI reports millivolts; reject invalid readings without
    guessing a different unit from their magnitude.
    """
    try:
        devices = sorted(drm_root.glob("card*/device"))
    except OSError:
        return None
    for device in devices:
        try:
            vendor = (device / "vendor").read_text(encoding="ascii", errors="ignore").strip().lower()
        except OSError:
            continue
        if vendor != "0x1002":
            continue
        try:
            sensors = sorted((device / "hwmon").glob("hwmon*"))
        except OSError:
            continue
        for sensor in sensors:
            try:
                labels = sorted(sensor.glob("in*_label"))
            except OSError:
                continue
            for label_path in labels:
                try:
                    label = label_path.read_text(encoding="ascii", errors="ignore").strip().lower()
                    input_path = label_path.with_name(label_path.name.replace("_label", "_input"))
                    raw = int(input_path.read_text(encoding="ascii").strip())
                except (OSError, ValueError):
                    continue
                if label != "vddgfx":
                    continue
                millivolts = raw
                # Same board-specific ceiling as the desktop reader: a kernel
                # without the BC-250 sensor patches can report a value that is
                # inside the generic hwmon range but still wrong (issue #7).
                if 400 <= millivolts <= 1_400:
                    return millivolts
    return None


def gpu_busy_percent(drm_root: pathlib.Path = pathlib.Path("/sys/class/drm")) -> int | None:
    """Read amdgpu's passive busy counter without waking another service."""
    try:
        devices = sorted(drm_root.glob("card*/device"))
    except OSError:
        return None
    for device in devices:
        try:
            vendor = (device / "vendor").read_text(encoding="ascii", errors="ignore").strip().lower()
            value = int((device / "gpu_busy_percent").read_text(encoding="ascii").strip())
        except (OSError, ValueError):
            continue
        if vendor == "0x1002" and 0 <= value <= 100:
            return value
    return None


def gpu_vram_usage_mib(drm_root: pathlib.Path = pathlib.Path("/sys/class/drm")) -> tuple[int, int] | None:
    """Return dedicated VRAM used/total in MiB when amdgpu exports it."""
    try:
        devices = sorted(drm_root.glob("card*/device"))
    except OSError:
        return None
    for device in devices:
        try:
            vendor = (device / "vendor").read_text(encoding="ascii", errors="ignore").strip().lower()
            used = int((device / "mem_info_vram_used").read_text(encoding="ascii").strip())
            total = int((device / "mem_info_vram_total").read_text(encoding="ascii").strip())
        except (OSError, ValueError):
            continue
        if vendor == "0x1002" and 0 <= used <= total:
            return round(used / 1048576), round(total / 1048576)
    return None


def gpu_temperature_c(drm_root: pathlib.Path = pathlib.Path("/sys/class/drm")) -> float | None:
    """Read the AMD GPU edge temperature when the driver exposes one.

    This is intentionally a read-only best-effort metric.  Some BC-250
    SteamOS combinations do not export the AMD hwmon temperature; in that
    case the QAM must show no value rather than substitute a CPU or NCT value.
    """
    try:
        devices = sorted(drm_root.glob("card*/device"))
    except OSError:
        return None
    for device in devices:
        try:
            vendor = (device / "vendor").read_text(encoding="ascii", errors="ignore").strip().lower()
        except OSError:
            continue
        if vendor != "0x1002":
            continue
        for sensor in sorted((device / "hwmon").glob("hwmon*")):
            try:
                millidegrees = int((sensor / "temp1_input").read_text(encoding="ascii").strip())
            except (OSError, ValueError):
                continue
            if -40_000 <= millidegrees <= 150_000:
                return millidegrees / 1000.0
    return None


def _amdgpu_device(drm_root: pathlib.Path = pathlib.Path("/sys/class/drm")) -> pathlib.Path | None:
    try:
        devices = sorted(drm_root.glob("card*/device"))
    except OSError:
        return None
    for device in devices:
        try:
            vendor = (device / "vendor").read_text(encoding="ascii", errors="ignore").strip().lower()
        except OSError:
            continue
        if vendor == "0x1002":
            return device
    return None


def _amdgpu_dpm_actual_mhz(filename: str, drm_root: pathlib.Path = pathlib.Path("/sys/class/drm")) -> int | None:
    device = _amdgpu_device(drm_root)
    if device is None:
        return None
    try:
        payload = (device / filename).read_text(encoding="ascii", errors="ignore")
    except OSError:
