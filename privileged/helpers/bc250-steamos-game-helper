#!/usr/bin/python3
"""Limited privileged helper for BC250 Control Center on gaming distributions.

This helper is intentionally narrow. It exists because SteamOS Game Mode runs
apps under gamescope without a normal desktop Polkit authentication dialog or a
controlling TTY. The GUI calls it only on reviewed SteamOS, Bazzite or CachyOS
contexts; the helper independently validates the caller, hardware and session.
"""
from __future__ import annotations

