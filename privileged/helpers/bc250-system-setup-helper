#!/usr/bin/python3 -I
"""Finite memory/ACPI/VRAM transactions. No arbitrary command, path or root CLI."""
import argparse
import fcntl
import json
import os
import sys
from pathlib import Path


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=("status", "memory-plan", "memory-apply", "memory-boot",
                                           "acpi-install", "acpi-uninstall", "acpi-check",
                                           "telemetry-fix", "telemetry-restore",
                                           "vram-read", "vram-apply", "uninstall-check"))
    parser.add_argument("--policy", choices=("preserve", "restore", "swap-16", "swap-32", "zram", "zswap-16", "zswap-32"), default="preserve")
    parser.add_argument("--ttm", type=int, choices=(-1, 0, 8, 10, 12), default=0)
    parser.add_argument("--uma-size", type=int, default=0)
    parser.add_argument("--takeover-zram", action="store_true",
                         help="Confirm disabling an existing, foreign ZRAM to switch to ZSWAP")
    parser.add_argument("--target-mount", default=None,
                         help="Mount point for the swapfile; one of memory-plan's reported swap_targets")
    args = parser.parse_args()
    readonly = args.action in {"status", "memory-plan", "uninstall-check"}
    if not readonly and os.geteuid() != 0:
        parser.error("Administrator authorization is required")
    here = Path(__file__).resolve().parent
    lib = here / "lib" if (here / "lib").is_dir() else here.parent / "lib"
    if os.geteuid() == 0:
        for path in [lib, *lib.parents, *lib.glob("system_setup_*.py"), lib / "acpi_payload.py"]:
            info = path.stat()
            if path.is_symlink() or info.st_uid != 0 or info.st_mode & 0o022:
                parser.error(f"Untrusted helper dependency: {path}")
    sys.path.insert(0, str(lib))
    import system_setup_acpi as acpi
    import system_setup_memory as memory
    import system_setup_telemetry as telemetry
    import system_setup_vram as vram
    from system_setup_common import STATE, Host, SetupError

    host = Host()
    try:
        if args.action == "uninstall-check":
            blockers, steps, commands = uninstall_blockers(host, memory, STATE)
            if blockers:
                print(uninstall_guidance(blockers, steps, commands), file=sys.stderr)
                return 1
            return 0
        if readonly:
            memory_status = memory.status(host)
            memory_status["swap_targets"] = memory.candidate_swap_targets(host)
            result = {
                "memory": memory_status,
                "acpi": acpi.status(host),
                "telemetry": telemetry.status(host),
                "vram": vram.status(host),
                "protocol": 2,
            }
            if args.action == "memory-plan":
                result["request"] = {"policy": args.policy, "ttm_gib": args.ttm}
            print(json.dumps(result))
            return 0
        directory = host.safe(STATE)
        directory.mkdir(parents=True, exist_ok=True, mode=0o755)
        lock = host.safe(STATE + "/setup.lock")
        fd = os.open(lock, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            if args.action == "memory-apply":
                result = memory.apply(host, args.policy, args.ttm,
                                       takeover_zram=args.takeover_zram, target_mount=args.target_mount)
            elif args.action == "memory-boot":
                result = memory.boot(host)
            elif args.action == "acpi-install":
                result = acpi.install(host)
            elif args.action == "acpi-check":
                result = acpi.check(host)
            elif args.action == "telemetry-fix":
                result = telemetry.apply(host)
            elif args.action == "telemetry-restore":
                result = telemetry.restore(host)
            elif args.action == "vram-read":
                result = vram.read(host)
            elif args.action == "vram-apply":
                result = vram.apply(host, args.uma_size)
            else:
                result = acpi.uninstall(host)
        finally:
            os.close(fd)
        if args.action == "acpi-check":
            # The complete structured result is persisted in the bounded
            # root-owned probe cache. Keep the interactive terminal focused
            # on actionable guidance for people rather than dumping JSON.
            print(acpi.requirements_report(result))
        else:
            print(json.dumps(result))
        if result.get("restore_pending"):
            print("Restore deferred: the BC250 swapfile is still active and was preserved. Reboot, then check status.")
        print("BC250_RESULT status=ok component=system_setup code=0")
        if args.action == "acpi-check":
            availability = "available" if result.get("available") else "blocked by the reported compatibility reason"
            print(f"Inspection only: no setting was changed. ACPI installation is {availability}.")
        elif args.action == "vram-read":
            print("Inspection only: no setting was changed.")
        elif args.action == "vram-apply":
            print("The new VRAM size is written to CMOS and takes effect on next reboot; it is not an automatic reboot.")
        else:
            print("Review the reported state. Reboot is required for ACPI and ZRAM changes; no automatic reboot was requested.")
        return 0
    except (SetupError, OSError, ValueError, KeyError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        print("Setup was not confirmed. Existing user swap and original boot entries were not intentionally removed. Review status before retrying.", file=sys.stderr)
        return 1


HELPER = "/usr/libexec/bc250-control-center/bc250-system-setup-helper"
GIB = 1024 ** 3


def uninstall_blockers(host, memory, state_dir):
    """What this package still manages, and the command that puts each back.

    Removing the package with any of these in place leaves a boot service
    that calls a helper which no longer exists, or boot files nothing can
    restore any more. The package manager is stopped, and told exactly what
    to undo and how, instead of a bare "restore it first".
    """
    blockers, steps, commands = [], [], []
    state = host.state("memory")
    _, swap_file, _, unit_path = memory.swap_paths(host, state)
    memory_files = (memory.SERVICE_PATH, swap_file, memory.ZRAM, unit_path, memory.SYSCTL)
    if any(host.path(path).exists() for path in memory_files):
        policy = str(state.get("policy") or "preserve")
        if host.path(swap_file).exists():
            size = host.path(swap_file).stat().st_size
            in_use = swap_file in memory.swaps(host)
            blockers.append(
                f"Memory policy {policy} with a {round(size / GIB)} GiB swapfile at {swap_file}"
                + (" (in use)" if in_use else "")
            )
        elif policy != "preserve":
            blockers.append(f"Memory policy {policy}")
        if state.get("ttm_pages") is not None:
            ttm_gib = round(int(state["ttm_pages"]) * os.sysconf("SC_PAGE_SIZE") / GIB)
            blockers.append(f"GPU memory limit (TTM) set to {ttm_gib} GiB")
        if host.path(memory.SERVICE_PATH).exists():
            blockers.append(f"Boot service {Path(memory.SERVICE_PATH).name}, which runs this helper")
        ttm = "-1" if "ttm_original" in state else "0"
        steps.append("Dashboard > Prepare BC250 system > Memory & Swap > Restore > Apply")
        commands.append(f"sudo {HELPER} memory-apply --policy restore --ttm {ttm}")
    if host.path(state_dir + "/acpi.json").exists():
        blockers.append("CPU power management (ACPI) tables in the boot files")
        steps.append("Dashboard > Prepare BC250 system > Compatibility > CPU power management > Uninstall")
        commands.append(f"sudo {HELPER} acpi-uninstall")
    if host.path(state_dir + "/telemetry.json").exists():
        blockers.append("GPU telemetry correction")
        commands.append(f"sudo {HELPER} telemetry-restore")
    return blockers, steps, commands


def uninstall_guidance(blockers, steps, commands):
    lines = ["", "BC250 Control Center still manages these settings on this machine:"]
    lines += [f"  - {item}" for item in blockers]
    lines += [
        "Removing the package now would leave them behind with nothing to undo them,",
        "and a boot service that fails on every boot.",
        "",
        "Put them back first, then remove the package again.",
    ]
    if steps:
        lines.append("  In Control Center:")
        lines += [f"    {step}" for step in steps]
    lines.append("  Or in a terminal:")
    lines += [f"    {command}" for command in commands]
    lines += [
        "  If the swapfile was in use, the restore finishes on the next boot: restart,",
        "  then run the removal again.",
        "",
    ]
    return "\n".join(lines)


if __name__ == "__main__":
    raise SystemExit(main())
