#!/usr/bin/env bash
set -euo pipefail
BC250_PERMISSION_REPAIR_PROTOCOL=1

# This prefix is also embedded in application workflows. Keep it standalone:
# recovery must not import installed helper modules through an unsafe ancestor.
repair_permissions() {
    /usr/bin/python3 -I - "${1:-apply}" <<'PY'
import os
import stat
import sys

check = sys.argv[1] == "check"
if not check and os.geteuid() != 0:
    raise SystemExit("Administrator authorization is required")
needed = False
def open_directory(path):
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    fd = os.open("/", flags)
    try:
        for component in path.strip("/").split("/") if path != "/" else ():
            child = os.open(component, flags, dir_fd=fd)
            os.close(fd)
            fd = child
        return fd
    except OSError:
        os.close(fd)
        raise

for path in ("/", "/usr", "/usr/libexec", "/etc", "/var", "/var/lib"):
    try:
        # Bind the metadata check and chmod to the same directory, and refuse
        # symlinks. Never chown, recurse, or remove special permission bits.
        fd = open_directory(path)
    except OSError:
        continue
    try:
        info = os.fstat(fd)
        mode = stat.S_IMODE(info.st_mode)
        if (info.st_uid, info.st_gid) != (0, 0) or mode not in (0o775, 0o777):
            continue
        needed = True
        if not check:
            os.fchmod(fd, 0o755)
            if stat.S_IMODE(os.fstat(fd).st_mode) != 0o755:
                raise RuntimeError(f"Permission repair did not verify: {path}")
            print(f"BC250 permission repair: {path} uid=0 gid=0 mode={mode:04o} -> 0755", flush=True)
    finally:
        os.close(fd)
if check:
    raise SystemExit(0 if needed else 1)
PY
}

case "${1:-}" in
  post-install)
    repair_permissions
    # Package-manager upgrades normally remove files no longer owned by the
    # new package. This explicit cleanup also covers hand-built 1.18 packages
    # whose legacy mvc/ tree was not tracked consistently.
    rm -rf -- /usr/share/bc250-control-center/mvc
    if command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
      gtk-update-icon-cache -q -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
    fi
    ;;
  repair-permissions)
    repair_permissions
    ;;
  pre-remove)
    helper=/usr/libexec/bc250-control-center/bc250-system-setup-helper
    if [[ -x "$helper" ]]; then
      "$helper" uninstall-check
    fi
    # The system fan control service (GitHub #15) runs the fan helper this
    # package is about to remove. Stop it and give the fan back to firmware
    # first, or the unit would fail on every boot afterwards.
    fan_helper=/usr/libexec/bc250-control-center/bc250-fan-pwm-helper
    if [[ -x "$fan_helper" ]] && {
      [[ -f /etc/systemd/system/bc250-fan-control.service ]] || [[ -f /etc/init.d/bc250-fan-control ]]
    }; then
      printf 'CONTROL DISABLE\nEXIT\n' | "$fan_helper" >/dev/null 2>&1 || true
    fi
    # "Export to Decky" writes these at run time, so no package owns them;
    # left behind, a later install showed those old profiles in Game Mode.
    for kind in gpu cpu fan; do
      rm -f -- "/etc/bc250-control-center/decky-$kind-profiles.json"
    done
    rmdir --ignore-fail-on-non-empty /etc/bc250-control-center 2>/dev/null || true
    # Python writes bytecode caches next to the modules whenever root runs a
    # helper or the CLI (the uninstall-check above included). No package owns
    # them, so without this the removal leaves both trees behind holding
    # nothing but __pycache__ directories.
    for tree in /usr/libexec/bc250-control-center /usr/share/bc250-control-center; do
      if [[ -d "$tree" ]]; then
        find "$tree" -xdev -type d -name __pycache__ -prune -exec rm -rf -- {} + 2>/dev/null || true
      fi
    done
    ;;
  *)
    echo "Usage: $0 {post-install|pre-remove|repair-permissions}" >&2
    exit 64
    ;;
esac
