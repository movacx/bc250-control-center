def _load_gpu_profile_overrides(
    path: pathlib.Path = DECKY_GPU_PROFILES_PATH,
) -> dict[str, dict[str, object]]:
    try:
        metadata = path.lstat()
    except OSError:
        return {}
    if not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode):
        return {}
    if metadata.st_uid != 0 or metadata.st_mode & 0o022:
        return {}
    if metadata.st_size > 16 * 1024:
        return {}
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return {}
    if not isinstance(document, dict) or document.get("schema") != 1:
        return {}
    entries = document.get("profiles")
    if not isinstance(entries, list):
        return {}
    overrides: dict[str, dict[str, object]] = {}
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        key = entry.get("key")
        name = entry.get("name")
        minimum = entry.get("min")
        maximum = entry.get("max")
        if (
            key not in GPU_PROFILES
            or not isinstance(name, str) or not 1 <= len(name) <= 40
            or isinstance(minimum, bool) or not isinstance(minimum, int)
            or isinstance(maximum, bool) or not isinstance(maximum, int)
            or not 100 <= minimum < maximum <= 3000
        ):
            continue
        overrides[key] = {"name": name, "min": minimum, "max": maximum}
    return overrides


