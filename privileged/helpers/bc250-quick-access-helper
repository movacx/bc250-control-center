def bc250_present() -> bool:
    try:
        devices = tuple(pathlib.Path("/sys/bus/pci/devices").iterdir())
    except OSError:
        devices = ()
    for device in devices:
        try:
            vendor = (device / "vendor").read_text(encoding="ascii", errors="ignore").strip().lower()
            device_id = (device / "device").read_text(encoding="ascii", errors="ignore").strip().lower()
        except OSError:
            continue
        if vendor.lstrip("0x") == "1002" and device_id.lstrip("0x") == "13fe":
            return True
    return False


# ----------------------------------------------------------- VRAM (UMA_SIZE)
#
# Writes the APU frame-buffer size into the same battery-backed CMOS bank the
# ABL/BIOS firmware reads at boot (github.com/fanoush/bc250_memcfg), mirroring
# privileged/lib/system_setup_vram.py, which the desktop's own VRAM control
# uses. Kept as a second, self-contained copy rather than an import: this
# helper is a closed, root-owned payload that accepts only named operations
# and has no dependency on the desktop's privileged library tree (see the
# module docstring). Only the UMA_SIZE field is ever changed; the rest of the
# 28-byte bank is read back unmodified and rewritten byte-for-byte.
VRAM_DEVICE = pathlib.Path("/dev/port")
VRAM_INDEX_PORT = 0x72
VRAM_DATA_PORT = 0x73
VRAM_BANK_OFFSET = 0x90
VRAM_BANK_SIZE = 28
VRAM_UMA_SIZE_OFFSET = 26
VRAM_CHECKSUM_FIELD_OFFSET = 6
VRAM_SIGNATURE = 0x42435041


def _vram_read_index_byte(port, offset: int) -> int:
    port.seek(VRAM_INDEX_PORT)
    port.write(bytes((offset,)))
    port.seek(VRAM_DATA_PORT)
    read = port.read(1)
    if not read:
        raise RuntimeError("Short read from BC250 CMOS I/O ports")
    return read[0]


def _vram_write_index_byte(port, offset: int, value: int) -> None:
    port.seek(VRAM_INDEX_PORT)
    port.write(bytes((offset,)))
    port.seek(VRAM_DATA_PORT)
    port.write(bytes((value & 0xFF,)))


def _vram_read_bank(port) -> bytearray:
    return bytearray(_vram_read_index_byte(port, VRAM_BANK_OFFSET + i) for i in range(VRAM_BANK_SIZE))


def _vram_write_bank(port, bank: bytearray) -> None:
    for i, value in enumerate(bank):
        _vram_write_index_byte(port, VRAM_BANK_OFFSET + i, value)


def vram_status(*, port_open=None) -> dict[str, object]:
    """Read-only UMA_SIZE snapshot published with every ``status`` call.

    ``boot_id`` rides along so the panel can tell "I wrote this value to CMOS"
    apart from "the firmware has actually booted with it": comparing the two
    across a real reboot is the same boot-identity trick
    ``cu_live_state_boot_id`` already uses to expire stale /run state, reused
    here so a pending-reboot notice can survive a Game Mode tab switch (this
    plugin remounts its React tree per tab) without ever surviving an actual
    reboot by mistake.
    """
    boot_id = cu_live_state_boot_id()
    if not bc250_present():
        return {"supported": False, "reason": "AMD BC-250 hardware identity was not detected", "uma_size_mb": None, "boot_id": boot_id}
    if not VRAM_DEVICE.exists():
        return {"supported": False, "reason": "/dev/port is not available on this kernel", "uma_size_mb": None, "boot_id": boot_id}
    opener = port_open or (lambda: open(VRAM_DEVICE, "r+b", buffering=0))
    try:
        port = opener()
    except OSError as error:
        return {"supported": False, "reason": f"Cannot access BC250 CMOS I/O ports: {error}", "uma_size_mb": None, "boot_id": boot_id}
    try:
        bank = _vram_read_bank(port)
    finally:
        port.close()
    uma_size_mb = bank[VRAM_UMA_SIZE_OFFSET] | (bank[VRAM_UMA_SIZE_OFFSET + 1] << 8)
    return {"supported": True, "reason": "", "uma_size_mb": uma_size_mb, "boot_id": boot_id}


def vram_apply(size_mb: int, *, port_open=None) -> dict[str, object]:
    """Write one contracted VRAM preset to CMOS. Takes effect on next boot."""
    current = vram_status(port_open=port_open)
    if not current["supported"]:
        raise RuntimeError(
            "QUICK_ACCESS_VRAM: " + (current["reason"] or "BC250 VRAM configuration is unavailable.")
        )
    opener = port_open or (lambda: open(VRAM_DEVICE, "r+b", buffering=0))
    try:
        port = opener()
    except OSError as error:
        raise RuntimeError(f"QUICK_ACCESS_VRAM: Cannot access BC250 CMOS I/O ports: {error}") from error
    try:
        bank = _vram_read_bank(port)
        bank[VRAM_UMA_SIZE_OFFSET] = size_mb & 0xFF
        bank[VRAM_UMA_SIZE_OFFSET + 1] = (size_mb >> 8) & 0xFF
        bank[0:4] = VRAM_SIGNATURE.to_bytes(4, "little")
        checksum = sum(bank[VRAM_CHECKSUM_FIELD_OFFSET:]) & 0xFFFF
        bank[4:6] = checksum.to_bytes(2, "little")
        _vram_write_bank(port, bank)
    finally:
        port.close()
    return {"applied_uma_size_mb": size_mb}


def vram_apply_action(raw_size_mb: str) -> int:
    try:
        size_mb = int(raw_size_mb)
    except ValueError:
        return fail("QUICK_ACCESS_VRAM: Invalid VRAM size.", 2)
    if size_mb not in VRAM_SIZE_PRESETS_MB:
        return fail("QUICK_ACCESS_VRAM: Unsupported VRAM size.", 2)
    try:
        result = vram_apply(size_mb)
    except RuntimeError as error:
        return fail(str(error), 51)
    print(json.dumps({
        "ok": True,
        **result,
        "message": "VRAM size written to CMOS. Restart your console to activate it.",
    }))
    return 0


def memory_runtime_state(
    proc_swaps: pathlib.Path = pathlib.Path("/proc/swaps"),
    zswap_enabled: pathlib.Path = pathlib.Path("/sys/module/zswap/parameters/enabled"),
    ttm_pages_limit: pathlib.Path = pathlib.Path("/sys/module/ttm/parameters/pages_limit"),
) -> dict[str, object]:
    """Expose bounded read-only memory state; never change swap or a karg."""
    zram_bytes = 0
    backing_bytes = 0
    try:
        lines = proc_swaps.read_text(encoding="utf-8", errors="strict").splitlines()[1:]
    except (OSError, UnicodeError):
        lines = ()
    for line in lines:
        columns = line.split()
        if len(columns) < 3:
            continue
        try:
            size = max(0, int(columns[2], 10)) * 1024
        except ValueError:
            continue
        if pathlib.Path(columns[0]).name.startswith("zram"):
            zram_bytes += size
        else:
            backing_bytes += size
    try:
        zswap_value = zswap_enabled.read_text(encoding="ascii", errors="strict").strip().lower()
    except (OSError, UnicodeError):
        zswap_value = ""
    try:
        pages = int(ttm_pages_limit.read_text(encoding="ascii", errors="strict").strip(), 10)
    except (OSError, UnicodeError, ValueError):
        pages = None
    page_size = int(os.sysconf("SC_PAGE_SIZE"))
    return {
        "memory_zram_active": zram_bytes > 0,
        "memory_zram_total_bytes": zram_bytes,
        "memory_backing_swap_active": backing_bytes > 0,
        "memory_backing_swap_total_bytes": backing_bytes,
        "memory_zswap_enabled": True if zswap_value in {"1", "y", "yes", "true"} else False if zswap_value in {"0", "n", "no", "false"} else None,
        "memory_ttm_pages_limit": pages,
        "memory_ttm_limit_bytes": pages * page_size if pages is not None and pages >= 0 else None,
    }


def system_memory_state(
    meminfo: pathlib.Path = pathlib.Path("/proc/meminfo"),
    storage_root: str = "/",
) -> dict[str, object]:
    """Bounded read-only RAM/swap/storage snapshot for the Memory & Video tab."""
    fields: dict[str, int] = {}
    try:
        for line in meminfo.read_text(encoding="ascii", errors="strict").splitlines():
            key, _, rest = line.partition(":")
            parts = rest.strip().split()
            if not parts:
                continue
            try:
                fields[key] = int(parts[0]) * 1024
            except ValueError:
                continue
    except OSError:
        fields = {}
    try:
        usage = shutil.disk_usage(storage_root)
        storage_total, storage_used = usage.total, usage.used
    except OSError:
        storage_total = storage_used = None
    return {
        "memory_ram_total_bytes": fields.get("MemTotal"),
        "memory_ram_available_bytes": fields.get("MemAvailable"),
        "memory_swap_total_bytes": fields.get("SwapTotal"),
        "memory_swap_free_bytes": fields.get("SwapFree"),
        "storage_total_bytes": storage_total,
        "storage_used_bytes": storage_used,
    }


def gpu_core_mhz(drm_root: pathlib.Path = pathlib.Path("/sys/class/drm")) -> int | None:
    """Read the current marked AMD DPM core clock without issuing a command."""
    try:
        devices = sorted(drm_root.glob("card*/device"))
    except OSError:
        return None
    for device in devices:
        dpm = device / "pp_dpm_sclk"
        try:
            vendor = (device / "vendor").read_text(encoding="ascii", errors="ignore").strip().lower()
            payload = dpm.read_text(encoding="ascii", errors="ignore")
        except OSError:
            continue
        if vendor != "0x1002":
            continue
        for line in payload.splitlines():
            match = re.search(r"\b(\d+)\s*(?:mhz|mhs)\b.*\*", line, re.IGNORECASE)
            if match and 100 <= int(match.group(1)) <= 5000:
                return int(match.group(1))
    return None


