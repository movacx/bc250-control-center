#!/usr/bin/python3 -I
# Prepare the transient Cyan fix-freq bind target before systemd starts Cyan.
#
# Cyan's upstream frequency fix bind-mounts /dev/shm/patched_freq_metrics on
# the amdgpu hwmon freq1_input file.  SteamOS can renumber hwmon directories
# while a service is being restarted.  A previous mount targeting the old
# directory then prevents a clean restart, even though the governor TOML and
# the voltage curve are valid.  This helper is deliberately narrow: it only
# lazily unmounts that exact Cyan-owned source below the BC-250 PCI device;
# it never writes a GPU register or changes a clock/voltage value.
from __future__ import annotations

import glob
import os
import pathlib
import stat
from pathlib import Path
import subprocess
import sys
import tempfile
import time


DEVICE = Path("/sys/bus/pci/devices/0000:01:00.0")


def cyan_frequency_targets() -> list[Path]:
    return [
        Path(candidate)
        for candidate in glob.glob(str(DEVICE / "hwmon/hwmon*/freq1_input"))
    ]


def target_accepts_bind_mount(target: Path) -> bool:
    """Prove that this volatile sysfs target is mountable before Cyan starts.

    The probe is executed while Cyan is stopped. It bind-mounts an empty
    temporary file only long enough to validate the kernel path, immediately
    unmounts it, and never writes a GPU sysfs attribute or hardware register.
    """
    temporary_name = ""
    try:
        descriptor, temporary_name = tempfile.mkstemp(
            prefix="bc250-cyan-preflight-", dir="/dev/shm"
        )
        os.close(descriptor)
        mounted = subprocess.run(
            ["/usr/bin/mount", "--bind", temporary_name, str(target)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=4,
            check=False,
        ).returncode == 0
        if mounted:
            subprocess.run(
                ["/usr/bin/umount", "--", str(target)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=4,
                check=False,
            )
        return mounted
    except (OSError, subprocess.SubprocessError):
        return False
    finally:
        if temporary_name:
            Path(temporary_name).unlink(missing_ok=True)


def _trusted_self() -> bool:
    """Refuse to run from a copy the system does not own.

    Every other helper in this directory checks this; these two did not. The
    check is about the *installed* path: if this file, or any directory above
    it, is a symbolic link or is writable by anyone but root, then whatever is
    executing here is not necessarily what the package installed — and it is
    executing as root.

    A run straight from a source checkout is normal during development, so a
    file outside the installed prefixes is left alone; the guard applies where
    the packaged helper lives.
    """
    path = pathlib.Path(__file__).resolve()
    prefixes = ('/usr/libexec/', '/usr/local/libexec/', '/usr/lib/')
    if not str(path).startswith(prefixes):
        return True
    for part in (path, *path.parents):
        try:
            info = part.lstat()
        except OSError:
            return False
        if stat.S_ISLNK(info.st_mode):
            return False
        if info.st_uid != 0 or info.st_mode & 0o022:
            return False
        if str(part) == path.anchor:
            break
    return True


#: Cyan's two transient tmpfs sources.  When Cyan stops it deletes the files
#: but leaves the bind mounts behind, so mountinfo then reports their root as
#: "/patched_gpu_metrics//deleted".  A new Cyan cannot bind on top of such a
#: stale mount (move_mount: ENOENT), exits, and systemd restarts it forever.
CYAN_MOUNT_ROOTS = ("/patched_freq_metrics", "/patched_gpu_metrics")


def _unescape_mountinfo(field: str) -> str:
    return (
        field.replace("\\040", " ").replace("\\011", "\t")
        .replace("\\012", "\n").replace("\\134", "\\")
    )


def stale_cyan_mounts(mountinfo: str, device: Path) -> list[str]:
    """Cyan's own bind mounts below the BC-250 device, newest first.

    Only the exact Cyan tmpfs sources (live or deleted) on the device's
    gpu_metrics file or an amdgpu hwmon freq1_input are eligible; any other
    mount is left alone.
    """
    device_root = os.path.realpath(device)
    targets: list[str] = []
    for line in mountinfo.splitlines():
        fields = line.split()
        if len(fields) < 5:
            continue
        root = _unescape_mountinfo(fields[3])
        target = _unescape_mountinfo(fields[4])
        if root.endswith("//deleted"):
            root = root[: -len("//deleted")]
        if root not in CYAN_MOUNT_ROOTS:
            continue
        relative = os.path.relpath(target, device_root)
        if relative.startswith(".."):
            continue
        parts = Path(relative).parts
        if parts == ("gpu_metrics",) or (
            len(parts) == 3 and parts[0] == "hwmon"
            and parts[1].startswith("hwmon") and parts[2] == "freq1_input"
        ):
            targets.append(target)
    return list(reversed(targets))


def unmount_stale_cyan_mounts() -> None:
    # Mounts can be stacked after several failed restarts: repeat until none
    # remains, bounded so a mount that refuses to go cannot hang the start.
    for _ in range(16):
        try:
            mountinfo = Path("/proc/self/mountinfo").read_text(encoding="utf-8")
        except OSError:
            return
        targets = stale_cyan_mounts(mountinfo, DEVICE)
        if not targets:
            return
        for target in targets:
            try:
                subprocess.run(
                    ["/usr/bin/umount", "-l", "--", target],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=4,
                    check=False,
                )
            except (OSError, subprocess.SubprocessError):
                return


def main() -> int:
    unmount_stale_cyan_mounts()

    # Avoid racing udev directly after a governor stop, but never hold the
    # service start for a long time.  On some SteamOS kernels the target is
    # created only *by Cyan while it starts*: waiting 75 seconds here delayed
    # that start, then made the caller's D-Bus deadline expire before Cyan had
    # a chance to complete its own retry loop.  A short best-effort probe
    # catches an already-ready target; Cyan remains the authoritative retry
    # owner when the target appears later.
    for _ in range(40):
        for path in cyan_frequency_targets():
            if path.is_file() and path.exists() and target_accepts_bind_mount(path):
                return 0
        time.sleep(0.25)
    return 0


if __name__ == "__main__":
    # systemd runs this as root from Cyan's ExecStartPre. Run as anyone else it
    # can only fail at the first umount, silently, which reads as "the guard
    # ran and found nothing wrong" — the opposite of the truth.
    if os.geteuid() != 0:
        print(
            "ERROR: This preflight runs as root from the Cyan service drop-in.",
            file=sys.stderr,
        )
        raise SystemExit(77)
    if not _trusted_self():
        print(
            "ERROR: HELPER_UNTRUSTED: this preflight is not a root-owned, "
            "non-writable installed payload.",
            file=sys.stderr,
        )
        raise SystemExit(77)
    raise SystemExit(main())
