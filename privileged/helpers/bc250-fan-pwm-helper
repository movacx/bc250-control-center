#!/usr/bin/python3 -I
"""Root-side, narrowly scoped PWM writer for BC250 Control Center."""

from __future__ import annotations

import fcntl
import json
import os
import stat
import sys
import tempfile
import time
from contextlib import contextmanager, suppress
from pathlib import Path

PWM_MIN = 1
PWM_MAX = 12
VALUE_MIN = 0
VALUE_MAX = 255

# NCT6687 exposes the requested manual mode before the duty register is
# necessarily ready to consume a new value.  Keep this bounded, but allow the
# register enough time to complete the automatic -> manual transition.  These
# values deliberately match the hardened Quick Access path.
PWM_MODE_VERIFY_ATTEMPTS = 10
PWM_MODE_VERIFY_INTERVAL_SECONDS = 0.05
PWM_MODE_SETTLE_SECONDS = 0.15
PWM_DUTY_VERIFY_ATTEMPTS = 16
PWM_DUTY_VERIFY_INTERVAL_SECONDS = 0.10
FAN_OPERATION_LOCK = Path('/run/bc250-control-center-fan.lock')
FAN_OPERATION_LOCK_TIMEOUT_SECONDS = 3.0

# Every duty this helper verifies is mirrored here so a root systemd unit can
# replay it at boot without pkexec ever being involved (see --restore-boot
# below).  /var/lib survives a reboot; /run does not.
STATE_DIR = Path('/var/lib/bc250-control-center')
STATE_FILE = STATE_DIR / 'fan-last-applied.json'


@contextmanager
def fan_operation_lock():
    flags = os.O_CREAT | os.O_RDWR | getattr(os, 'O_CLOEXEC', 0)
    flags |= getattr(os, 'O_NOFOLLOW', 0)
    descriptor = os.open(FAN_OPERATION_LOCK, flags, 0o600)
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != 0
            or metadata.st_mode & 0o077
        ):
            raise RuntimeError('Unsafe fan operation lock.')
        deadline = time.monotonic() + FAN_OPERATION_LOCK_TIMEOUT_SECONDS
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError('Another fan operation is still in progress.')
                time.sleep(0.025)
        yield
    finally:
        os.close(descriptor)


def bc250_identity_present() -> bool:
    """Require the BC-250 identity before driving anyone's fans.

    ``find_sensor`` matches any hwmon whose name starts with ``nct``, which is
    a family of Nuvoton Super-I/O chips found on a great many ordinary
    motherboards. Every other fan path in this project checks the hardware
    first; this helper did not, and it is reachable by an administrator on any
    machine. Same check as the Game Mode helper: the BC-250's PCI id, or an
    explicit DMI board/product name.
    """
    try:
        devices = tuple(Path('/sys/bus/pci/devices').iterdir())
    except OSError:
        devices = ()
    for device in devices:
        try:
            vendor = (device / 'vendor').read_text(encoding='ascii', errors='ignore').strip().lower()
            device_id = (device / 'device').read_text(encoding='ascii', errors='ignore').strip().lower()
        except OSError:
            continue
        if vendor in {'0x1002', '1002'} and device_id in {'0x13fe', '13fe'}:
            return True
    for path in (
        Path('/sys/class/dmi/id/board_name'),
        Path('/sys/class/dmi/id/product_name'),
    ):
        try:
            if 'bc-250' in path.read_text(encoding='utf-8', errors='ignore').lower():
                return True
        except OSError:
            continue
    return False


def find_sensor() -> Path | None:
    base = Path('/sys/class/hwmon')
    for hwmon in sorted(base.glob('hwmon*')):
        try:
            name = (hwmon / 'name').read_text(encoding='utf-8').strip().lower()
        except OSError:
            continue
        if name.startswith(('nct668', 'nct67', 'nct')):
            return hwmon
    return None


def _load_state() -> dict:
    try:
        with STATE_FILE.open('r', encoding='utf-8') as stream:
            data = json.load(stream)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def _save_state(state: dict) -> None:
    """Best-effort persistence: a write failure here must never fail a fan write."""
    try:
        STATE_DIR.mkdir(mode=0o755, exist_ok=True)
        fd, name = tempfile.mkstemp(prefix='.fan-last-applied-', dir=STATE_DIR)
        temporary = Path(name)
    except OSError:
        return
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as stream:
            json.dump(state, stream)
        os.chmod(temporary, 0o644)
        os.replace(temporary, STATE_FILE)
    except OSError:
        with suppress(FileNotFoundError):
            os.unlink(temporary)


def _remember_applied(channel: int, value: int) -> None:
    state = _load_state()
    channels = state.get('channels')
    channels = dict(channels) if isinstance(channels, dict) else {}
    channels[str(channel)] = value
    state['channels'] = channels
    _save_state(state)


def _forget_applied(channel: int) -> None:
    state = _load_state()
    channels = state.get('channels')
    if not isinstance(channels, dict) or str(channel) not in channels:
        return
    channels = dict(channels)
    del channels[str(channel)]
    state['channels'] = channels
    _save_state(state)


def write_sysfs(path: Path, value: int) -> None:
    flags = os.O_WRONLY
    if hasattr(os, 'O_NOFOLLOW'):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags)
    try:
        os.write(fd, f'{value}\n'.encode('ascii'))
    finally:
        os.close(fd)


def wait_for_sysfs_value(
    path: Path,
    expected: str,
    *,
    retry_value: int | None = None,
    attempts: int,
    interval: float,
) -> tuple[bool, str, int, float]:
    """Wait for a hwmon register and optionally re-send its same duty.

    A first duty write can be acknowledged while the NCT controller is still
    switching out of firmware automatic control.  Retrying *only the already
    validated same value* makes the transition reliable without turning this
    helper into a general sysfs writer.
    """
    started = time.monotonic()
    observed = ''
    for attempt in range(1, max(1, attempts) + 1):
        observed = path.read_text(encoding='ascii').strip()
        if observed == expected:
            return True, observed, attempt, (time.monotonic() - started) * 1000
        if attempt < attempts:
            time.sleep(interval)
            if retry_value is not None:
                write_sysfs(path, retry_value)
    return False, observed, max(1, attempts), (time.monotonic() - started) * 1000


def restore_previous_automatic_mode(enable_path: Path | None, was_automatic: bool) -> str:
    """Best-effort rollback only when this request left firmware automatic.

    Do not force a channel that was already manual back to automatic: that
    would overwrite an existing explicit user choice.  A failed transition
    from automatic mode, however, must not leave a board fan in an unverified
    manual state.
    """
    if not was_automatic or enable_path is None:
        return ''
    try:
        write_sysfs(enable_path, 2)
        restored, observed, _attempts, _elapsed = wait_for_sysfs_value(
            enable_path,
            '2',
            attempts=PWM_MODE_VERIFY_ATTEMPTS,
            interval=PWM_MODE_VERIFY_INTERVAL_SECONDS,
        )
    except OSError as exc:
        return f' Previous automatic-mode rollback failed: {exc}.'
    if restored:
        return ' Previous automatic mode was restored.'
    return f' Previous automatic-mode rollback read-back was {observed!r}.'


def apply_pwm(channel: int, value: int) -> str:
    if channel < PWM_MIN or channel > PWM_MAX:
        return f'ERR PWM channel must be between {PWM_MIN} and {PWM_MAX}.'
    if value < VALUE_MIN or value > VALUE_MAX:
        return f'ERR PWM value must be between {VALUE_MIN} and {VALUE_MAX}.'

    sensor = find_sensor()
    if sensor is None:
        return 'ERR No NCT hwmon sensor was found.'

    pwm_path = sensor / f'pwm{channel}'
    enable_path = sensor / f'pwm{channel}_enable'
    if not pwm_path.is_file():
        return f'ERR {pwm_path} does not exist.'

    was_automatic = False
    try:
        if enable_path.is_file():
            was_automatic = enable_path.read_text(encoding='ascii').strip() == '2'
            write_sysfs(enable_path, 1)
            mode_ready, observed, attempts, elapsed_ms = wait_for_sysfs_value(
                enable_path,
                '1',
                attempts=PWM_MODE_VERIFY_ATTEMPTS,
                interval=PWM_MODE_VERIFY_INTERVAL_SECONDS,
            )
            if not mode_ready:
                rollback = restore_previous_automatic_mode(enable_path, was_automatic)
                return (
                    f'ERR PWM {channel} manual-mode read-back was {observed!r} after '
                    f'{attempts} attempts/{elapsed_ms:.1f} ms.{rollback}'
                )
            time.sleep(PWM_MODE_SETTLE_SECONDS)

        write_sysfs(pwm_path, value)
        duty_ready, observed, attempts, elapsed_ms = wait_for_sysfs_value(
            pwm_path,
            str(value),
            retry_value=value,
            attempts=PWM_DUTY_VERIFY_ATTEMPTS,
            interval=PWM_DUTY_VERIFY_INTERVAL_SECONDS,
        )
    except OSError as exc:
        return f'ERR {exc}'
    if not duty_ready:
        rollback = restore_previous_automatic_mode(
            enable_path if enable_path.is_file() else None,
            was_automatic,
        )
        return (
            f'ERR PWM {channel} duty read-back was {observed!r} after '
            f'{attempts} attempts/{elapsed_ms:.1f} ms.{rollback}'
        )
    _remember_applied(channel, value)
    return f'OK PWM {channel} {value}'


def restore_automatic(channel: int) -> str:
    if channel < PWM_MIN or channel > PWM_MAX:
        return f'ERR PWM channel must be between {PWM_MIN} and {PWM_MAX}.'
    sensor = find_sensor()
    if sensor is None:
        return 'ERR No NCT hwmon sensor was found.'
    enable_path = sensor / f'pwm{channel}_enable'
    if not enable_path.is_file():
        return f'ERR {enable_path} does not exist; automatic mode cannot be restored.'
    try:
        write_sysfs(enable_path, 2)
        restored, confirmed, attempts, elapsed_ms = wait_for_sysfs_value(
            enable_path,
            '2',
            attempts=PWM_MODE_VERIFY_ATTEMPTS,
            interval=PWM_MODE_VERIFY_INTERVAL_SECONDS,
        )
    except OSError as exc:
        return f'ERR {exc}'
    if not restored:
        return (
            f'ERR PWM {channel} automatic-mode readback was {confirmed!r} after '
            f'{attempts} attempts/{elapsed_ms:.1f} ms, expected 2.'
        )
    _forget_applied(channel)
    return f'OK PWM {channel} AUTO'


def session() -> int:
    # Every other helper in this directory refuses before it does anything.
    # This one announced READY and opened its command session to any local
    # user, then failed on each individual write instead. Failing closed here
    # keeps the privileged surface uniform and the failure legible.
    if os.geteuid() != 0:
        print('ERR This helper must run as root through pkexec.', flush=True)
        return 77
    if not bc250_identity_present():
        print(
            'ERR HARDWARE_CONTEXT: AMD BC-250 hardware identity was not detected.',
            flush=True,
        )
        return 19
    print('READY', flush=True)
    for raw_line in sys.stdin:
        line = raw_line.strip()
        if not line:
            continue
        if line == 'EXIT':
            print('BYE', flush=True)
            return 0
        try:
            parts = line.split()
            if len(parts) == 2 and parts[0] == 'AUTO':
                with fan_operation_lock():
                    result = restore_automatic(int(parts[1]))
                print(result, flush=True)
                continue
            if len(parts) != 2:
                raise ValueError('Expected PWM channel and value, or AUTO and channel.')
            with fan_operation_lock():
                result = apply_pwm(int(parts[0]), int(parts[1]))
            print(result, flush=True)
        except (RuntimeError, ValueError, OSError) as exc:
            print(f'ERR {exc}', flush=True)
    return 0


def restore_boot_state() -> int:
    """Reapply the last verified PWM duty directly, with no pkexec involved.

    A systemd unit runs this as root at boot, the same way nct6687-load.service
    already brings the module back without any prompt.  It only ever replays a
    (channel, value) pair this same helper already wrote and verified once
    through the normal, authenticated session() path.
    """
    if os.geteuid() != 0:
        print('ERR This helper must run as root.', flush=True)
        return 77
    if not bc250_identity_present():
        print(
            'ERR HARDWARE_CONTEXT: AMD BC-250 hardware identity was not detected.',
            flush=True,
        )
        return 19
    channels = _load_state().get('channels')
    if not isinstance(channels, dict) or not channels:
        print('OK nothing to restore', flush=True)
        return 0
    failures = 0
    for channel_text, value in channels.items():
        try:
            channel = int(channel_text)
            value = int(value)
        except (TypeError, ValueError):
            failures += 1
            print(f'ERR invalid saved PWM entry {channel_text!r}={value!r}', flush=True)
            continue
        with fan_operation_lock():
            result = apply_pwm(channel, value)
        print(result, flush=True)
        if not result.startswith('OK'):
            failures += 1
    return 1 if failures else 0


if __name__ == '__main__':
    if len(sys.argv) > 1 and sys.argv[1] == '--restore-boot':
        raise SystemExit(restore_boot_state())
    raise SystemExit(session())
