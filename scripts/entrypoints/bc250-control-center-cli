#!/usr/bin/env sh
set -eu
if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
  echo "BC250 Control Center needs Python 3.11 or newer; this system has $(python3 -V 2>&1 || echo 'no python3')." >&2
  exit 2
fi
XDG_DATA_BASE="${XDG_DATA_HOME:-$HOME/.local/share}"
for APP_DIR in \
  "${BC250_CONTROL_CENTER_DIR:-}" \
  "$(CDPATH= cd -- "$(dirname -- "$0")/../share/bc250-control-center" 2>/dev/null && pwd || true)" \
  "$(CDPATH= cd -- "$(dirname -- "$0")/../.." 2>/dev/null && pwd || true)" \
  "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)" \
  "$XDG_DATA_BASE/bc250-control-center" \
  /usr/share/bc250-control-center \
  /usr/local/share/bc250-control-center; do
  if [ -n "$APP_DIR" ] && [ -f "$APP_DIR/frontends/cli.py" ]; then
    cd "$APP_DIR"
    export PYTHONPATH="$APP_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
    exec python3 -m frontends.cli "$@"
  fi
done
echo "BC250 Control Center headless installation was not found" >&2
exit 1
